+pub(crate) fn configure_start(options: &mut StartThreadOptions) -> Result<()> {
+    let supplied = options.thread_extension_init.get::<AgentWorkflowPolicy>();
+    let retained = options
+        .initial_history
+        .get_rollout_items()
+        .iter()
+        .find_map(|item| {
+            let RolloutItem::SessionMeta(meta) = item else {
+                return None;
+            };
+            Some(&meta.meta)
+        });
+    let retained_policy = retained.and_then(|meta| meta.agent_workflow_policy.as_ref());
+    if matches!(options.initial_history, InitialHistory::Forked(_))
+        && (supplied.is_some() || retained_policy.is_some())
+    {
+        return Err(invalid(
+            "managed forks and native children are not supported",
+        ));
+    }
+    match &options.initial_history {
+        InitialHistory::Resumed(_) if supplied.as_deref() != retained_policy => {
+            return Err(invalid("cold resume must retain the exact creation policy"));
+        }
+        _ => {}
+    }
+    let Some(policy) = supplied else {
+        return Ok(());
+    };
+    if options
+        .initial_history
+        .get_resumed_parent_thread_id()
+        .is_some()
+        || matches!(
+            options.session_source,
+            Some(codex_protocol::protocol::SessionSource::SubAgent(_))
+        )
+    {
+        return Err(invalid("native managed descendants are not supported"));
+    }
+    if !matches!(policy.protocol, 1) || !hex(&policy.policy_id, 64) {
+        return Err(invalid("unsupported policy protocol or identity"));
+    }
+    let expected_build = option_env!("AGENT_WORKFLOW_CODEX_BUILD_ID");
+    if !hex(&policy.build_id, 64) || expected_build != Some(policy.build_id.as_str()) {
+        return Err(invalid("policy requires its exact verified source build"));
+    }
+    if options
+        .initial_history
+        .get_selected_capability_roots()
+        .len()
+        > 0
+        || options
+            .thread_extension_init
+            .get::<Vec<codex_protocol::capabilities::SelectedCapabilityRoot>>()
+            .is_some_and(|roots| !roots.is_empty())
+    {
+        return Err(invalid(
+            "this profile has no selected-skill capability proof",
+        ));
+    }
+    let tools = if matches!(options.initial_history, InitialHistory::Resumed(_)) {
+        let original = retained
+            .and_then(|meta| meta.dynamic_tools.clone())
+            .unwrap_or_default();
+        let latest = options
+            .initial_history
+            .get_dynamic_tools()
+            .unwrap_or_default();
+        if latest != original || !options.dynamic_tools.is_empty() {
+            return Err(invalid("managed dynamic catalog cannot change on resume"));
+        }
+        original
+    } else {
+        options.dynamic_tools.clone()
+    };
+    validate_catalog(&policy, &tools)?;
+    // Admission precedes Session::new: ambient native initialization is not
+    // accounted broker work, even when its eventual tools would be filtered.
+    for feature in [
+        Feature::AsyncCompaction,
+        Feature::UnboundedConnectionRetries,
+        Feature::ResponsesWebsockets,
+        Feature::ResponsesWebsocketsV2,
+        Feature::GuardianApproval,
+        Feature::GuardianV2,
+        Feature::GuardianV2DecisionsComparison,
+        Feature::GuardianV3,
+        Feature::ShellSnapshot,
+        Feature::ShellSnapshotV2,
+        Feature::Apps,
+        Feature::Plugins,
+        Feature::RecommendedPlugins,
+        Feature::ToolSuggest,
+        Feature::ExecutorCapabilityDiscovery,
+        Feature::ExecutorCapabilityDiscoveryV2,
+        Feature::CodeMode,
+        Feature::CodeModeHost,
+        Feature::CodeModePrewarm,
+        Feature::CodeModeOnly,
+    ] {
+        options
+            .config
+            .features
+            .set_enabled(feature, false)
+            .map_err(|_| invalid("managed startup conflicts with required native feature"))?;
+        if options.config.features.enabled(feature) {
+            return Err(invalid("managed startup cannot retain a native feature"));
+        }
+    }
+    options
+        .thread_extension_init
+        .insert(crate::McpServersDisabled);
+    options
+        .thread_extension_init
+        .insert(crate::compact::AutoCompactionDisabled);
+    options.config.model_provider.request_max_retries = Some(0);
+    options.config.model_provider.stream_max_retries = Some(0);
+    options.config.model_provider.supports_websockets = false;
+    options.config.memories.generate_memories = false;
+    options.config.memories.use_memories = false;
+    let runtime = AgentWorkflowRuntime::new(policy.as_ref().clone());
+    if let InitialHistory::Resumed(history) = &options.initial_history {
+        let rollout = history
+            .rollout_path
+            .as_deref()
+            .ok_or_else(|| invalid("managed cold resume requires original local raw rollout"))?;
+        if !rollout.starts_with(&options.config.codex_home)
+            || rollout
+                .components()
+                .any(|part| matches!(part, std::path::Component::ParentDir))
+        {
+            return Err(invalid(
+                "managed raw rollout must remain in its original owned Codex home",
+            ));
+        }
+        runtime.load_journal(rollout, &history.conversation_id.to_string())?;
+    }
+    options.thread_extension_init.insert(runtime);
+    options
+        .thread_extension_init
+        .insert(SessionIsolation::Isolated);
+    options.thread_extension_init.insert(ToolPolicy {
+        allowed_tools: Some(
+            policy
+                .broker_tools
+                .iter()
+                .map(|name| ToolName::new(None, name.as_str()))
+                .collect(),
+        ),
+        require_managed_sandbox: false,
+        require_unified_exec: true,
+        expose_additional_permissions: false,
+    });
+    Ok(())
+}
