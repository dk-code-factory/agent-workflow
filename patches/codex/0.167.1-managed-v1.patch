+        let (runtime, model) = planned();
+        runtime.seal("response".into()).unwrap();
+        let dispatch = runtime.scheduled("a");
+        assert!(dispatch.is_admitted());
+        runtime.invalidate();
+        assert!(!dispatch.is_admitted());
+        drop(model);
+        drop(dispatch);
+        runtime.join_work().await;
+    }
