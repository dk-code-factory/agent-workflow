diff --git a/codex-rs/core/src/agent_workflow_journal.rs b/codex-rs/core/src/agent_workflow_journal.rs
new file mode 100644
index 0000000..8135bcc
--- /dev/null
+++ b/codex-rs/core/src/agent_workflow_journal.rs
@@ -0,0 +0,1244 @@
+//! Durable broker recovery records. Native normalized history is never a receipt.
+//!
+//! Journal I/O is synchronous within its owning model or control operation.
+//! Cancellation and accepted results can persist while the model is parked.
+//! This module deliberately
+//! rejects non-local/non-regular persistence, corrupt records and oversized data.
+//! It does not infer storage durability from the upstream buffered flush API.
+
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AgentWorkflowParkedBatch;
+use codex_protocol::protocol::AgentWorkflowPolicy;
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+const MAX_BYTES: usize = 16 * 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct OriginalCall {
+    pub id: String,
+    pub tool: String,
+    /// Preserve original JSON bytes, including whitespace and key ordering.
+    pub arguments: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum JournalPhase {
+    Sealed,
+    ResultsAccepted,
+    Completed,
+    Cancelled,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct BrokerJournal {
+    protocol: u32,
+    pub identity: AgentWorkflowParkedBatch,
+    pub calls: Vec<OriginalCall>,
+    /// Exact completed model usage observation, replayed under response_id.
+    pub usage: serde_json::Value,
+    pub phase: JournalPhase,
+    pub results: BTreeMap<String, DynamicToolResponse>,
+}
+
+fn invalid(message: &str) -> std::io::Error {
+    std::io::Error::other(format!("managed recovery hold: {message}"))
+}
+
+impl BrokerJournal {
+    pub(crate) fn sealed(
+        identity: AgentWorkflowParkedBatch,
+        calls: Vec<OriginalCall>,
+        usage: serde_json::Value,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<Self> {
+        let value = Self {
+            protocol: 1,
+            identity,
+            calls,
+            usage,
+            phase: JournalPhase::Sealed,
+            results: BTreeMap::new(),
+        };
+        value.validate(policy)?;
+        Ok(value)
+    }
+
+    pub(crate) fn validate(&self, policy: &AgentWorkflowPolicy) -> std::io::Result<()> {
+        if self.protocol != 1
+            || self.identity.policy_id != policy.policy_id
+            || self.identity.build_id != policy.build_id
+            || self.identity.response_id.is_empty()
+            || self.identity.thread_id.is_empty()
+            || self.identity.turn_id.is_empty()
+            || self.identity.invocation_id.is_empty()
+            || self.identity.batch_id.is_empty()
+            || self.calls.is_empty()
+            || self.calls.len() > 128
+        {
+            return Err(invalid("journal identity or policy differs"));
+        }
+        let mut ids = BTreeSet::new();
+        for call in &self.calls {
+            if call.id.is_empty()
+                || call.id.len() > 256
+                || !ids.insert(call.id.clone())
+                || !policy.broker_tools.contains(&call.tool)
+                || serde_json::from_str::<serde_json::Value>(&call.arguments).is_err()
+            {
+                return Err(invalid("invalid, duplicate or ungranted original call"));
+            }
+        }
+        if self.identity.call_ids != ids.iter().cloned().collect::<Vec<_>>() {
+            return Err(invalid("sealed complete call set differs"));
+        }
+        if self.results.keys().any(|id| !ids.contains(id))
+            || self
+                .results
+                .values()
+                .any(|result| result.agent_workflow_permit.is_some())
+        {
+            return Err(invalid("foreign result or retained stale permit"));
+        }
+        match self.phase {
+            JournalPhase::Sealed if !self.results.is_empty() => {
+                return Err(invalid("unsealed result set"));
+            }
+            JournalPhase::ResultsAccepted | JournalPhase::Completed
+                if self.results.len() != self.calls.len() =>
+            {
+                return Err(invalid("incomplete accepted result set"));
+            }
+            _ => {}
+        }
+        for field in ["input_tokens", "output_tokens", "total_tokens"] {
+            if self
+                .usage
+                .get(field)
+                .and_then(serde_json::Value::as_i64)
+                .is_none_or(|value| value < 0)
+            {
+                return Err(invalid("missing or invalid original usage witness"));
+            }
+        }
+        if serde_json::to_vec(self)
+            .map_err(std::io::Error::other)?
+            .len()
+            > MAX_BYTES
+        {
+            return Err(invalid("journal payload exceeds bound"));
+        }
+        Ok(())
+    }
+
+    /// Validate original raw rollout items BEFORE native history normalization.
+    /// Missing or synthetic `aborted` outputs do not establish a tool receipt.
+    pub(crate) fn validate_raw_calls(&self, history: &[ResponseItem]) -> std::io::Result<()> {
+        for call in &self.calls {
+            let matches = history
+                .iter()
+                .filter(|item| {
+                    matches!(item,
+                ResponseItem::FunctionCall { call_id, name, namespace, arguments, .. }
+                if call_id == &call.id && name == &call.tool && namespace.is_none()
+                    && arguments == &call.arguments)
+                })
+                .count();
+            let total = history
+                .iter()
+                .filter(|item| {
+                    matches!(item,
+                ResponseItem::FunctionCall { call_id, .. } if call_id == &call.id)
+                })
+                .count();
+            if matches != 1 || total != 1 {
+                return Err(invalid("missing, duplicated or changed raw original call"));
+            }
+        }
+        Ok(())
+    }
+
+    /// Merge only exact real semantic results. Missing native outputs may be
+    /// reconstructed from the already durable complete accepted receipt set;
+    /// `aborted`, changed, duplicated and foreign outputs never become receipts.
+    pub(crate) fn missing_real_outputs(
+        &self,
+        history: &[ResponseItem],
+    ) -> std::io::Result<Vec<ResponseItem>> {
+        self.validate_raw_calls(history)?;
+        if !matches!(
+            self.phase,
+            JournalPhase::ResultsAccepted | JournalPhase::Completed
+        ) {
+            return Err(invalid("no complete durable result set"));
+        }
+        let mut missing = Vec::new();
+        for (id, result) in &self.results {
+            let content = result
+                .content_items
+                .clone()
+                .into_iter()
+                .map(FunctionCallOutputContentItem::from)
+                .collect::<Vec<_>>();
+            let body = match content.as_slice() {
+                [FunctionCallOutputContentItem::InputText { text }] => {
+                    FunctionCallOutputBody::Text(text.clone())
+                }
+                _ => FunctionCallOutputBody::ContentItems(content),
+            };
+            let expected = FunctionCallOutputPayload {
+                body,
+                success: Some(result.success),
+            };
+            let existing = history
+                .iter()
+                .filter_map(|item| match item {
+                    ResponseItem::FunctionCallOutput {
+                        call_id: Some(call),
+                        output,
+                        ..
+                    } if call == id => Some(output),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            if existing.len() > 1
+                || existing
+                    .first() // Upstream persists only the body and restores success=None.
+                    // The accepted semantic journal remains the status authority.
+                    .is_some_and(|output| output.body != expected.body)
+            {
+                return Err(invalid("duplicated, synthetic or changed raw output"));
+            }
+            if existing.is_empty() {
+                missing.push(ResponseItem::FunctionCallOutput {
+                    id: None,
+                    call_id: Some(id.clone()),
+                    name: None,
+                    namespace: None,
+                    output: expected,
+                    internal_chat_message_metadata_passthrough: None,
+                });
+            }
+        }
+        Ok(missing)
+    }
+
+    pub(crate) fn complete(&mut self, history: &[ResponseItem]) -> std::io::Result<()> {
+        if self.phase != JournalPhase::ResultsAccepted
+            || !self.missing_real_outputs(history)?.is_empty()
+        {
+            return Err(invalid(
+                "all real outputs must be durable before completion",
+            ));
+        }
+        self.phase = JournalPhase::Completed;
+        Ok(())
+    }
+
+    /// An entire result set is accepted atomically before any callback oneshot.
+    pub(crate) fn accept_results(
+        &mut self,
+        results: BTreeMap<String, DynamicToolResponse>,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        if self.phase != JournalPhase::Sealed {
+            return Err(invalid("results already settled or journal cancelled"));
+        }
+        let previous = std::mem::replace(&mut self.results, results);
+        self.phase = JournalPhase::ResultsAccepted;
+        if let Err(error) = self.validate(policy) {
+            self.results = previous;
+            self.phase = JournalPhase::Sealed;
+            return Err(error);
+        }
+        Ok(())
+    }
+}
+
+/// Adjacent to the native generated rollout filename, never a model-supplied path.
+pub(crate) struct JournalFile {
+    path: PathBuf,
+}
+
+impl JournalFile {
+    pub(crate) fn for_rollout(path: &Path) -> std::io::Result<Self> {
+        if !path.is_absolute() || path.extension().and_then(|part| part.to_str()) != Some("jsonl") {
+            return Err(invalid("managed recovery requires a local JSONL rollout"));
+        }
+        check_parents(path)?;
+        Ok(Self {
+            path: path.with_extension("managed-broker.json"),
+        })
+    }
+
+    pub(crate) fn load(&self, policy: &AgentWorkflowPolicy) -> std::io::Result<BrokerJournal> {
+        let mut file = open_regular(&self.path, false)?;
+        if file.metadata()?.len() > MAX_BYTES as u64 {
+            return Err(invalid("journal file exceeds bound"));
+        }
+        let mut bytes = Vec::new();
+        Read::by_ref(&mut file)
+            .take((MAX_BYTES + 1) as u64)
+            .read_to_end(&mut bytes)?;
+        if bytes.len() > MAX_BYTES {
+            return Err(invalid("journal read exceeds bound"));
+        }
+        let value: BrokerJournal = serde_json::from_slice(&bytes).map_err(std::io::Error::other)?;
+        value.validate(policy)?;
+        Ok(value)
+    }
+
+    /// Write -> sync data/metadata -> atomic rename -> sync directory. A caller
+    /// MUST NOT dispatch or deliver results unless this complete barrier succeeds.
+    pub(crate) fn persist(
+        &self,
+        value: &BrokerJournal,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        value.validate(policy)?;
+        atomic_record(
+            &self.path,
+            &serde_json::to_vec(value).map_err(std::io::Error::other)?,
+        )
+    }
+}
+
+fn atomic_record(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    check_parents(path)?;
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) if !metadata.file_type().is_file() || metadata.nlink_checked() != 1 => {
+            return Err(invalid("journal is not an exclusively owned regular file"));
+        }
+        Ok(_) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error),
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| invalid("journal parent absent"))?;
+    let mut temp = tempfile::NamedTempFile::new_in(parent)?;
+    temp.write_all(bytes)?;
+    temp.as_file().sync_all()?;
+    temp.persist(path).map_err(|error| error.error)?;
+    sync_directory(parent)
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub(crate) struct ModelRequestIntent {
+    protocol: u32,
+    pub started: AgentWorkflowParkedBatch,
+    pub completed: Option<codex_protocol::protocol::AgentWorkflowModelWitness>,
+}
+
+impl ModelRequestIntent {
+    pub(crate) fn begin(
+        started: AgentWorkflowParkedBatch,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<Self> {
+        let value = Self {
+            protocol: 1,
+            started,
+            completed: None,
+        };
+        value.validate(policy)?;
+        Ok(value)
+    }
+    pub(crate) fn validate(&self, policy: &AgentWorkflowPolicy) -> std::io::Result<()> {
+        if self.protocol != 1
+            || self.started.thread_id.is_empty()
+            || self.started.turn_id.is_empty()
+            || self.started.invocation_id.is_empty()
+            || self.started.batch_id.is_empty()
+            || !self.started.response_id.is_empty()
+            || !self.started.call_ids.is_empty()
+            || self.started.build_id != policy.build_id
+            || self.started.policy_id != policy.policy_id
+        {
+            return Err(invalid("model intent identity or policy differs"));
+        }
+        if let Some(witness) = &self.completed {
+            let mut original = witness.batch.clone();
+            if original.response_id.is_empty() || original.call_ids.len() > 128 {
+                return Err(invalid("invalid completed model intent"));
+            }
+            original.response_id.clear();
+            original.call_ids.clear();
+            if original != self.started {
+                return Err(invalid("model completion changed original invocation"));
+            }
+        }
+        if serde_json::to_vec(self)
+            .map_err(std::io::Error::other)?
+            .len()
+            > 65536
+        {
+            return Err(invalid("model intent exceeds bound"));
+        }
+        Ok(())
+    }
+}
+
+pub(crate) struct IntentFile {
+    path: PathBuf,
+}
+impl IntentFile {
+    pub(crate) fn for_rollout(rollout: &Path) -> std::io::Result<Self> {
+        let _journal = JournalFile::for_rollout(rollout)?;
+        Ok(Self {
+            path: rollout.with_extension("managed-model.json"),
+        })
+    }
+    pub(crate) fn persist(
+        &self,
+        value: &ModelRequestIntent,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        value.validate(policy)?;
+        atomic_record(
+            &self.path,
+            &serde_json::to_vec(value).map_err(std::io::Error::other)?,
+        )
+    }
+    pub(crate) fn load(&self, policy: &AgentWorkflowPolicy) -> std::io::Result<ModelRequestIntent> {
+        let mut file = open_regular(&self.path, false)?;
+        if file.metadata()?.len() > 65536 {
+            return Err(invalid("oversized model intent"));
+        }
+        let mut bytes = Vec::new();
+        Read::by_ref(&mut file)
+            .take(65537)
+            .read_to_end(&mut bytes)?;
+        if bytes.len() > 65536 {
+            return Err(invalid("oversized model intent read"));
+        }
+        let value: ModelRequestIntent =
+            serde_json::from_slice(&bytes).map_err(std::io::Error::other)?;
+        value.validate(policy)?;
+        Ok(value)
+    }
+}
+
+/// Read original persisted records directly, before the native normalizer can
+/// manufacture missing `aborted` outputs. Any partial/corrupt line is a hold.
+pub(crate) struct RawRollout {
+    pub items: Vec<codex_history::RolloutItem>,
+    pub responses: Vec<ResponseItem>,
+}
+
+impl RawRollout {
+    pub(crate) fn validate_header(
+        &self,
+        thread: &str,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        let metadata = self
+            .items
+            .iter()
+            .filter_map(|item| match item {
+                codex_history::RolloutItem::SessionMeta(meta) => Some(&meta.meta),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if metadata.len() != 1
+            || metadata[0].id.to_string() != thread
+            || metadata[0].agent_workflow_policy.as_ref() != Some(policy)
+            || metadata[0].forked_from_id.is_some()
+            || metadata[0].parent_thread_id.is_some()
+        {
+            return Err(invalid(
+                "foreign, duplicated or unmanaged raw session metadata",
+            ));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn validate_intent_witness(
+        &self,
+        witness: &codex_protocol::protocol::AgentWorkflowModelWitness,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        let mut calls = BTreeMap::new();
+        for item in &self.responses {
+            if let ResponseItem::FunctionCall {
+                call_id,
+                name,
+                arguments,
+                namespace,
+                ..
+            } = item
+            {
+                if witness.batch.call_ids.contains(call_id) {
+                    if namespace.is_some()
+                        || !policy.broker_tools.contains(name)
+                        || calls
+                            .insert(
+                                call_id.clone(),
+                                OriginalCall {
+                                    id: call_id.clone(),
+                                    tool: name.clone(),
+                                    arguments: arguments.clone(),
+                                },
+                            )
+                            .is_some()
+                    {
+                        return Err(invalid("invalid or duplicated native intent call"));
+                    }
+                }
+            }
+        }
+        if calls.keys().cloned().collect::<Vec<_>>() != witness.batch.call_ids {
+            return Err(invalid("native intent call set differs"));
+        }
+        self.validate_completion(
+            &witness.batch,
+            &witness.usage,
+            &calls.values().cloned().collect::<Vec<_>>(),
+            policy,
+        )
+        .map(|_| ())
+    }
+
+    pub(crate) fn validate_journal(
+        &self,
+        journal: &BrokerJournal,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        journal.validate(policy)?;
+        journal.validate_raw_calls(&self.responses)?;
+        self.validate_completion(&journal.identity, &journal.usage, &journal.calls, policy)
+            .map(|_| ())
+    }
+
+    pub(crate) fn validate_completion(
+        &self,
+        identity: &AgentWorkflowParkedBatch,
+        usage: &serde_json::Value,
+        calls: &[OriginalCall],
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<codex_protocol::protocol::AgentWorkflowModelWitness> {
+        let metadata = self
+            .items
+            .iter()
+            .filter_map(|item| match item {
+                codex_history::RolloutItem::SessionMeta(meta) => Some(&meta.meta),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if metadata.len() != 1
+            || metadata[0].id.to_string() != identity.thread_id
+            || metadata[0].agent_workflow_policy.as_ref() != Some(policy)
+            || metadata[0].forked_from_id.is_some()
+            || metadata[0].parent_thread_id.is_some()
+        {
+            return Err(invalid(
+                "foreign, duplicated or unmanaged raw session metadata",
+            ));
+        }
+        let matching = self
+            .items
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| match item {
+                codex_history::RolloutItem::TokenUsageRecord(record)
+                    if record.response_id == identity.response_id =>
+                {
+                    Some((index, record))
+                }
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if matching.len() != 1 {
+            return Err(invalid(
+                "missing or duplicated actual native Completed witness",
+            ));
+        }
+        let (completed_index, record) = matching[0];
+        let expected = codex_protocol::protocol::AgentWorkflowModelWitness {
+            batch: identity.clone(),
+            usage: usage.clone(),
+        };
+        if record.thread_id.to_string() != identity.thread_id
+            || record.turn_id != identity.turn_id
+            || record.agent_workflow_witness.as_ref() != Some(&expected)
+        {
+            return Err(invalid(
+                "native Completed identity, invocation, callset or usage differs",
+            ));
+        }
+        let actual_usage = serde_json::to_value(&record.usage).map_err(std::io::Error::other)?;
+        let mut journal_usage = usage.clone();
+        if let Some(object) = journal_usage.as_object_mut() {
+            object.remove("codex_rollout_budget_units");
+        }
+        if actual_usage != journal_usage {
+            return Err(invalid("independent actual native usage differs"));
+        }
+        let previous_index = self.items[..completed_index]
+            .iter()
+            .rposition(|item| matches!(item, codex_history::RolloutItem::TokenUsageRecord(_)))
+            .map_or(0, |index| index + 1);
+        let mut actual_calls = BTreeMap::new();
+        for item in &self.items[previous_index..completed_index] {
+            if let codex_history::RolloutItem::ResponseItem(envelope) = item {
+                if let ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    arguments,
+                    ..
+                } = &envelope.item
+                {
+                    if namespace.is_some()
+                        || actual_calls
+                            .insert(
+                                call_id.clone(),
+                                OriginalCall {
+                                    id: call_id.clone(),
+                                    tool: name.clone(),
+                                    arguments: arguments.clone(),
+                                },
+                            )
+                            .is_some()
+                    {
+                        return Err(invalid(
+                            "foreign namespace or duplicated actual response call",
+                        ));
+                    }
+                }
+            }
+        }
+        if actual_calls
+            .values()
+            .cloned()
+            .collect::<Vec<_>>()
+            .as_slice()
+            != calls
+        {
+            return Err(invalid(
+                "journal omitted, added or changed original response calls",
+            ));
+        }
+        if self.items[completed_index + 1..].iter().any(|item| matches!(item,
+            codex_history::RolloutItem::ResponseItem(envelope) if matches!(envelope.item, ResponseItem::FunctionCall { .. }))) {
+            return Err(invalid("later original calls lack this sealed journal"));
+        }
+        Ok(expected)
+    }
+}
