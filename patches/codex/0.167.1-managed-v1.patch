+/// Read original persisted records directly, before the native normalizer can
+/// manufacture missing `aborted` outputs. Any partial/corrupt line is a hold.
+pub(crate) struct RawRollout {
+    pub items: Vec<codex_history::RolloutItem>,
+    pub responses: Vec<ResponseItem>,
+}
+
+impl RawRollout {
+    pub(crate) fn validate_header(
+        &self,
+        thread: &str,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        let metadata = self
+            .items
+            .iter()
+            .filter_map(|item| match item {
+                codex_history::RolloutItem::SessionMeta(meta) => Some(&meta.meta),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if metadata.len() != 1
+            || metadata[0].id.to_string() != thread
+            || metadata[0].agent_workflow_policy.as_ref() != Some(policy)
+            || metadata[0].forked_from_id.is_some()
+            || metadata[0].parent_thread_id.is_some()
+        {
+            return Err(invalid(
+                "foreign, duplicated or unmanaged raw session metadata",
+            ));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn validate_intent_witness(
+        &self,
+        witness: &codex_protocol::protocol::AgentWorkflowModelWitness,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        let mut calls = BTreeMap::new();
+        for item in &self.responses {
+            if let ResponseItem::FunctionCall {
+                call_id,
+                name,
+                arguments,
+                namespace,
+                ..
+            } = item
+                && witness.batch.call_ids.contains(call_id)
+                && (namespace.is_some()
+                    || !policy.broker_tools.contains(name)
+                    || calls
+                        .insert(
+                            call_id.clone(),
+                            OriginalCall {
+                                id: call_id.clone(),
+                                tool: name.clone(),
+                                arguments: arguments.clone(),
+                            },
+                        )
+                        .is_some())
+            {
+                return Err(invalid("invalid or duplicated native intent call"));
+            }
+        }
+        if calls.keys().cloned().collect::<Vec<_>>() != witness.batch.call_ids {
+            return Err(invalid("native intent call set differs"));
+        }
+        self.validate_completion(
+            &witness.batch,
+            &witness.usage,
+            &calls.values().cloned().collect::<Vec<_>>(),
+            policy,
+        )
+        .map(|_| ())
+    }
+
+    pub(crate) fn validate_journal(
+        &self,
+        journal: &BrokerJournal,
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<()> {
+        journal.validate(policy)?;
+        journal.validate_raw_calls(&self.responses)?;
+        self.validate_completion(&journal.identity, &journal.usage, &journal.calls, policy)
+            .map(|_| ())
+    }
+
+    pub(crate) fn validate_completion(
+        &self,
+        identity: &AgentWorkflowParkedBatch,
+        usage: &serde_json::Value,
+        calls: &[OriginalCall],
+        policy: &AgentWorkflowPolicy,
+    ) -> std::io::Result<codex_protocol::protocol::AgentWorkflowModelWitness> {
+        let metadata = self
+            .items
+            .iter()
+            .filter_map(|item| match item {
+                codex_history::RolloutItem::SessionMeta(meta) => Some(&meta.meta),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if metadata.len() != 1
+            || metadata[0].id.to_string() != identity.thread_id
+            || metadata[0].agent_workflow_policy.as_ref() != Some(policy)
+            || metadata[0].forked_from_id.is_some()
+            || metadata[0].parent_thread_id.is_some()
+        {
+            return Err(invalid(
+                "foreign, duplicated or unmanaged raw session metadata",
+            ));
+        }
+        let matching = self
+            .items
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| match item {
+                codex_history::RolloutItem::TokenUsageRecord(record)
+                    if record.response_id == identity.response_id =>
+                {
+                    Some((index, record))
+                }
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if matching.len() != 1 {
+            return Err(invalid(
+                "missing or duplicated actual native Completed witness",
+            ));
+        }
+        let (completed_index, record) = matching[0];
+        let expected = codex_protocol::protocol::AgentWorkflowModelWitness {
+            batch: identity.clone(),
+            usage: usage.clone(),
+        };
+        if record.thread_id.to_string() != identity.thread_id
+            || record.turn_id != identity.turn_id
+            || record.agent_workflow_witness.as_deref() != Some(&expected)
+        {
+            return Err(invalid(
+                "native Completed identity, invocation, callset or usage differs",
+            ));
+        }
+        let actual_usage = serde_json::to_value(&record.usage).map_err(std::io::Error::other)?;
+        let mut journal_usage = usage.clone();
+        if let Some(object) = journal_usage.as_object_mut() {
+            object.remove("codex_rollout_budget_units");
+        }
+        if actual_usage != journal_usage {
+            return Err(invalid("independent actual native usage differs"));
+        }
+        let previous_index = self.items[..completed_index]
+            .iter()
+            .rposition(|item| matches!(item, codex_history::RolloutItem::TokenUsageRecord(_)))
+            .map_or(0, |index| index + 1);
+        let mut actual_calls = BTreeMap::new();
+        for item in &self.items[previous_index..completed_index] {
+            if let codex_history::RolloutItem::ResponseItem(envelope) = item
+                && let ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    arguments,
+                    ..
+                } = &envelope.item
+                && (namespace.is_some()
+                    || actual_calls
+                        .insert(
+                            call_id.clone(),
+                            OriginalCall {
+                                id: call_id.clone(),
+                                tool: name.clone(),
+                                arguments: arguments.clone(),
+                            },
+                        )
+                        .is_some())
+            {
+                return Err(invalid(
+                    "foreign namespace or duplicated actual response call",
+                ));
+            }
+        }
+        if actual_calls
+            .values()
+            .cloned()
+            .collect::<Vec<_>>()
+            .as_slice()
+            != calls
+        {
+            return Err(invalid(
+                "journal omitted, added or changed original response calls",
+            ));
+        }
+        if self.items[completed_index + 1..].iter().any(|item| matches!(item,
+            codex_history::RolloutItem::ResponseItem(envelope) if matches!(envelope.item, ResponseItem::FunctionCall { .. }))) {
+            return Err(invalid("later original calls lack this sealed journal"));
+        }
+        Ok(expected)
+    }
+}
+
+pub(crate) fn read_raw_rollout(path: &Path) -> std::io::Result<RawRollout> {
+    const MAX_RAW_BYTES: usize = 64 * 1024 * 1024;
+    let mut file = open_regular(path, false)?;
+    if file.metadata()?.len() > MAX_RAW_BYTES as u64 {
+        return Err(invalid("raw rollout exceeds managed recovery bound"));
+    }
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file)
+        .take((MAX_RAW_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_RAW_BYTES || bytes.last() != Some(&b'\n') {
+        return Err(invalid(
+            "oversized, missing or partial original raw rollout",
+        ));
+    }
+    let mut items = Vec::new();
+    let mut responses = Vec::new();
+    for line in bytes
+        .split(|byte| *byte == b'\n')
+        .filter(|line| !line.is_empty())
+    {
+        let decoded =
+            codex_rollout::parse_rollout_line_bytes(line).map_err(std::io::Error::other)?;
+        if let codex_history::RolloutItem::ResponseItem(envelope) = &decoded.item {
+            responses.push(envelope.item.clone());
+        }
+        items.push(decoded.item);
+    }
+    Ok(RawRollout { items, responses })
+}
+
+/// This is additional to, and ordered AFTER, upstream LiveThread.flush().
+/// No storage guarantee is inferred from that buffered writer method's name.
+pub(crate) fn sync_raw_rollout(path: &Path) -> std::io::Result<()> {
+    check_parents(path)?;
+    open_regular(path, false)?.sync_all()?;
+    sync_directory(
+        path.parent()
+            .ok_or_else(|| invalid("rollout parent absent"))?,
+    )
+}
+
+trait LinkCount {
+    fn nlink_checked(&self) -> u64;
+}
+impl LinkCount for std::fs::Metadata {
+    fn nlink_checked(&self) -> u64 {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            self.nlink()
+        }
+        #[cfg(not(unix))]
+        {
+            0
+        }
+    }
+}
+
+fn check_parents(path: &Path) -> std::io::Result<()> {
+    let mut current = path.parent().ok_or_else(|| invalid("path parent absent"))?;
+    loop {
+        let metadata = std::fs::symlink_metadata(current)?;
+        if !metadata.is_dir() || metadata.file_type().is_symlink() {
+            return Err(invalid("non-directory or aliased persistence parent"));
+        }
+        match current.parent() {
+            Some(parent) => current = parent,
+            None => return Ok(()),
+        }
+    }
+}
+
+fn open_regular(path: &Path, write: bool) -> std::io::Result<File> {
+    check_parents(path)?;
+    let mut options = OpenOptions::new();
+    options.read(true).write(write);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    #[cfg(not(unix))]
+    {
+        return Err(invalid(
+            "managed journal requires supported Unix file barriers",
+        ));
+    }
+    let file = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.file_type().is_file() || metadata.nlink_checked() != 1 {
+        return Err(invalid(
+            "persistence is not an exclusively owned regular file",
+        ));
+    }
+    Ok(file)
+}
+
+/// A first seal may follow lazy creation of several native rollout directory
+/// levels. Sync each entry's containing directory once per live thread, from
+/// inner to outer; later journal renames only need their immediate parent sync.
+pub(crate) fn sync_parent_entries_once(
+    path: &Path,
+    synced: &mut BTreeSet<PathBuf>,
+) -> std::io::Result<()> {
+    let mut parent = path
+        .parent()
+        .ok_or_else(|| invalid("rollout parent absent"))?;
+    for _ in 0..128 {
+        if !synced.contains(parent) {
+            sync_directory(parent)?;
+            synced.insert(parent.to_path_buf());
+        }
+        match parent.parent() {
+            Some(next) => parent = next,
+            None => return Ok(()),
+        }
+    }
+    Err(invalid("persistence directory ancestry exceeds bound"))
+}
+
+fn sync_directory(path: &Path) -> std::io::Result<()> {
+    let file = File::open(path)?;
+    if !file.metadata()?.is_dir() {
+        return Err(invalid("sync target is not a directory"));
+    }
+    file.sync_all()
+}
