+struct ManagedSourceAbortTailTask {
+    forced: bool,
+    started: Arc<Notify>,
+    stopped: Arc<std::sync::atomic::AtomicBool>,
+    abort_entered: Arc<Notify>,
+    abort_release: Arc<Notify>,
+}
+
+impl SessionTask for ManagedSourceAbortTailTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.managed_source_abort_tail"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        struct Stopped(Arc<std::sync::atomic::AtomicBool>);
+        impl Drop for Stopped {
+            fn drop(&mut self) {
+                self.0.store(true, std::sync::atomic::Ordering::Release);
+            }
+        }
+        let _stopped = Stopped(Arc::clone(&self.stopped));
+        self.started.notify_one();
+        if self.forced {
+            // The source's 100ms abort deadline must destroy and join this run
+            // future. The independent 5s bound also cleans up any test failure.
+            tokio::time::sleep(StdDuration::from_secs(5)).await;
+        } else {
+            timeout(StdDuration::from_secs(5), cancellation.cancelled())
+                .await
+                .expect("owned graceful cancellation deadline");
+        }
+        Err(CodexErr::TurnAborted)
+    }
+    async fn abort(&self, _session: Arc<Session>, _ctx: Arc<TurnContext>) {
+        assert!(
+            self.stopped.load(std::sync::atomic::Ordering::Acquire),
+            "the real task future must be joined before the external abort tail"
+        );
+        self.abort_entered.notify_one();
+        timeout(StdDuration::from_secs(5), self.abort_release.notified())
+            .await
+            .expect("owned external abort-tail release deadline");
+    }
+}
