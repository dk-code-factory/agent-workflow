new file mode 100644
index 0000000..e7b7b18
--- /dev/null
+++ b/codex-rs/core/src/agent_workflow_recovery.rs
@@ -0,0 +0,110 @@
+//! Replays one original native broker seal through the existing dynamic-tool
+//! callback path before RegularTask can sample. No new user input or agent loop.
+
+use crate::AgentWorkflowInvocation;
+use crate::AgentWorkflowRecovery;
+use crate::AgentWorkflowRuntime;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use std::sync::Arc;
+use tokio::task::JoinSet;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) async fn replay_before_sampling(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    cancellation: &CancellationToken,
+) -> Result<()> {
+    let Some(recovery) = turn.extension_data.get::<AgentWorkflowRecovery>() else {
+        return Ok(());
+    };
+    let runtime = session
+        .services
+        .thread_extension_data
+        .get::<AgentWorkflowRuntime>()
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("managed recovery has no original policy".into())
+        })?;
+    let invocation = turn
+        .extension_data
+        .get::<AgentWorkflowInvocation>()
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("managed recovery has no original invocation".into())
+        })?;
+    if recovery.0.thread_id != session.thread_id.to_string()
+        || recovery.0.turn_id != turn.sub_id
+        || recovery.0.invocation_id != invocation.0
+        || cancellation.is_cancelled()
+    {
+        return Err(CodexErr::InvalidRequest(
+            "managed recovery ownership differs".into(),
+        ));
+    }
+    let rollout = session
+        .current_rollout_path()
+        .await
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("managed recovery requires its original local rollout".into())
+        })?;
+    // begin_recovery reads independent raw native envelopes/witnesses before
+    // any history normalization or result reconstruction.
+    let (_batch, calls) = runtime.begin_recovery(&recovery.0, &rollout)?;
+    let jobs = calls
+        .into_iter()
+        .map(|call| {
+            let work = runtime.scheduled(&call.id);
+            (call, work)
+        })
+        .collect::<Vec<_>>();
+    let mut tasks = JoinSet::new();
+    for (call, work) in jobs {
+        let session = Arc::clone(session);
+        let turn = Arc::clone(turn);
+        let cancel = cancellation.child_token();
+        tasks.spawn(async move {
+            let _work = work;
+            if !_work.is_admitted() || cancel.is_cancelled() {
+                return false;
+            }
+            let Ok(arguments) = serde_json::from_str(&call.arguments) else {
+                return false;
+            };
+            crate::tools::handlers::request_managed_dynamic_tool(
+                &session,
+                &turn,
+                call.id,
+                codex_tools::ToolName::new(None, call.tool),
+                arguments,
+                cancel,
+            )
+            .await
+            .is_some()
+        });
+    }
+    let mut settled = true;
+    while let Some(result) = tasks.join_next().await {
+        if !matches!(result, Ok(true)) {
+            settled = false;
+            tasks.abort_all();
+        }
+    }
+    if !settled || cancellation.is_cancelled() {
+        runtime.invalidate();
+        return Err(CodexErr::TurnAborted);
+    }
+    // All public callbacks received identical original semantic receipts under
+    // this fresh epoch. Append only missing real outputs, never duplicate or
+    // accept upstream synthetic aborted outputs as receipts.
+    let missing = runtime.recovered_outputs(&rollout)?;
+    if !missing.is_empty() {
+        session
+            .record_conversation_items(turn, &turn.capture_current_model_info(), &missing)
+            .await;
+    }
+    session.flush_rollout().await?;
+    runtime.complete_durable(&rollout)?;
+    Ok(())
+}
