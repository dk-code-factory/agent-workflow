+    fn raw_witness(journal: &BrokerJournal) -> RawRollout {
+        use codex_history::{ResponseItemEnvelope, RolloutItem};
+        use codex_protocol::protocol::{
+            AgentWorkflowModelWitness, SessionMeta, SessionMetaLine, TokenUsage, TokenUsageRecord,
+        };
+        let thread = codex_protocol::ThreadId::from_string(&journal.identity.thread_id).unwrap();
+        let mut metadata = SessionMeta::default();
+        metadata.id = thread;
+        metadata.session_id = thread.into();
+        metadata.agent_workflow_policy = Some(policy());
+        let usage: TokenUsage = serde_json::from_value(journal.usage.clone()).unwrap();
+        let record = TokenUsageRecord {
+            agent_workflow_witness: Some(AgentWorkflowModelWitness {
+                batch: journal.identity.clone(),
+                usage: journal.usage.clone(),
+            }),
+            thread_id: thread,
+            turn_id: journal.identity.turn_id.clone(),
+            session_id: thread.into(),
+            root_turn_id: journal.identity.turn_id.clone(),
+            response_id: journal.identity.response_id.clone(),
+            usage: usage.clone(),
+            turn_token_usage: usage.clone(),
+            thread_token_usage: usage,
+        };
+        RawRollout {
+            items: vec![
+                RolloutItem::SessionMeta(Box::new(SessionMetaLine {
+                    meta: metadata,
+                    git: None,
+                })),
+                RolloutItem::ResponseItem(ResponseItemEnvelope::new(raw_call())),
+                RolloutItem::TokenUsageRecord(record),
+            ],
+            responses: vec![raw_call()],
+        }
+    }
