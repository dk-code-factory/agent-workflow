+        let (runtime, _batch) = planned();
+        runtime.seal("response".into()).unwrap();
+        let first = runtime.scheduled("a");
+        runtime.park("a").unwrap();
+        runtime.invalidate();
+        assert!(runtime.published("a").is_err());
+        drop(first);
+        drop(_batch);
+        runtime.join_work().await;
