+            let (_directory, rollout, policy, mut journal) = recovery_fixture(false);
+            let mut original = journal.identity.clone();
+            match invalid {
+                "invocation" => original.invocation_id.push('x'),
+                "batch" => original.batch_id.push('x'),
+                "cancelled" => {
+                    journal.phase = JournalPhase::Cancelled;
+                    JournalFile::for_rollout(&rollout)
+                        .unwrap()
+                        .persist(&journal, &policy)
+                        .unwrap();
+                }
+                "unknown-attempt" => {
+                    let file = IntentFile::for_rollout(&rollout).unwrap();
+                    let mut intent = file.load(&policy).unwrap();
+                    intent.started.batch_id.push('x');
+                    file.persist(&intent, &policy).unwrap();
