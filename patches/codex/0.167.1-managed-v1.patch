+    #[tokio::test]
+    async fn revocation_waits_for_unpolled_and_independently_spawned_work() {
+        let (runtime, _batch) = planned();
+        runtime.seal("response".into()).unwrap();
+        let queued_guard = runtime.scheduled("a");
+        let queued = async move {
+            let _work = queued_guard;
