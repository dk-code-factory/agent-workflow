+        changed.completed.as_mut().unwrap().batch.invocation_id = "foreign".into();
+        assert!(file.persist(&changed, &policy()).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn real_atomic_write_failure_preserves_original_unknown_intent() {
+        use std::os::unix::fs::PermissionsExt;
+        if unsafe { libc::geteuid() } == 0 {
+            return;
+        } // POSIX root bypasses the intended negative control.
+        let directory = tempfile::tempdir().unwrap();
+        let rollout = directory.path().join("rollout-original.jsonl");
+        std::fs::write(&rollout, "original raw bytes\n").unwrap();
+        let journal = record();
+        let mut started = journal.identity.clone();
+        started.response_id.clear();
+        started.call_ids.clear();
+        let value = ModelRequestIntent::begin(started, &policy()).unwrap();
+        let file = IntentFile::for_rollout(&rollout).unwrap();
+        file.persist(&value, &policy()).unwrap();
+        let original = std::fs::read(&file.path).unwrap();
+        std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o500)).unwrap();
+        let failure = file.persist(&value, &policy());
+        std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+        assert_eq!(
+            failure.unwrap_err().kind(),
+            std::io::ErrorKind::PermissionDenied
+        );
+        assert_eq!(std::fs::read(&file.path).unwrap(), original);
+        assert!(file.load(&policy()).unwrap().completed.is_none());
+    }
+
+    #[test]
+    fn durable_roundtrip_and_corruption_fail_closed() {
+        let directory = tempfile::tempdir().unwrap();
+        let rollout = directory.path().join("rollout-generated.jsonl");
+        std::fs::write(&rollout, "original raw history\n").unwrap();
+        sync_raw_rollout(&rollout).unwrap();
+        let file = JournalFile::for_rollout(&rollout).unwrap();
+        assert!(file.load(&policy()).is_err());
+        file.persist(&record(), &policy()).unwrap();
+        let loaded = file.load(&policy()).unwrap();
+        assert_eq!(loaded.calls, record().calls);
+        assert_eq!(loaded.usage, record().usage);
+        assert_eq!(loaded.phase, JournalPhase::Sealed);
+        let mut changed = policy();
+        changed.build_id = "c".repeat(64);
+        assert!(file.load(&changed).is_err());
+        std::fs::write(&file.path, "{\"truncated\":").unwrap();
+        assert!(file.load(&policy()).is_err());
+        std::fs::remove_file(&file.path).unwrap();
+        std::fs::create_dir(&file.path).unwrap();
+        assert!(file.persist(&record(), &policy()).is_err());
+    }
+
+    #[test]
+    fn bounds_and_missing_usage_precede_journal_writes() {
+        let mut journal = record();
+        journal.usage = serde_json::Value::Null;
+        assert!(journal.validate(&policy()).is_err());
+        let mut journal = record();
+        journal.calls[0].arguments = format!("\"{}\"", "a".repeat(MAX_BYTES));
+        assert!(journal.validate(&policy()).is_err());
+        let mut journal = record();
+        journal.calls.push(journal.calls[0].clone());
+        assert!(journal.validate(&policy()).is_err());
+        let mut journal = record();
+        journal.phase = JournalPhase::Completed;
+        assert!(journal.validate(&policy()).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn aliased_paths_cannot_replace_owned_journal_or_rollout() {
+        use std::os::unix::fs::symlink;
+        let directory = tempfile::tempdir().unwrap();
+        let original = directory.path().join("rollout-original.jsonl");
+        std::fs::write(&original, "original\n").unwrap();
+        let alias = directory.path().join("rollout-alias.jsonl");
+        symlink(&original, &alias).unwrap();
+        assert!(sync_raw_rollout(&alias).is_err());
+        let file = JournalFile::for_rollout(&original).unwrap();
+        symlink(&original, &file.path).unwrap();
+        assert!(file.persist(&record(), &policy()).is_err());
+        assert_eq!(std::fs::read_to_string(&original).unwrap(), "original\n");
+        std::fs::remove_file(&file.path).unwrap();
+        std::fs::hard_link(&original, &file.path).unwrap();
+        assert!(file.load(&policy()).is_err());
+        assert!(file.persist(&record(), &policy()).is_err());
+    }
+}
