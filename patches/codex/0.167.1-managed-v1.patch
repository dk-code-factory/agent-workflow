+        .published("prior-call")
+        .expect("original published callback")
+        .expect("original full-batch permit");
+    runtime.invalidate();
+    drop(original_batch);
+    drop(original_task);
+    drop(original_work);
+    turn.extension_data
+        .insert(crate::AgentWorkflowInvocation("later-turn".into()));
+    let started = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    timeout(
+        StdDuration::from_secs(2),
+        session.start_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            ManagedSourceTask {
+                polled: Arc::new(std::sync::atomic::AtomicBool::new(false)),
+                started: Arc::clone(&started),
+                release: Arc::clone(&release),
+            },
+        ),
+    )
+    .await
+    .expect("later setup deadline");
+    timeout(StdDuration::from_secs(2), started.notified())
+        .await
+        .expect("later task executing");
+    let (tx_sub, rx_sub) = async_channel::bounded(1);
+    let (_tx_event, rx_event) = async_channel::unbounded();
+    let io = SessionIo {
+        agent_workflow_managed: true,
+        tx_sub,
+        rx_event,
+        agent_status: watch::channel(AgentStatus::PendingInit).1,
+        session_loop_termination: completed_session_loop_termination(),
+    };
+    let response = codex_protocol::dynamic_tools::DynamicToolResponse {
+        agent_workflow_permit: Some(original_permit),
+        content_items: Vec::new(),
+        success: true,
+    };
+    assert!(
+        io.submit(Op::DynamicToolResponse {
+            id: "prior-call".into(),
+            response: response.clone()
+        })
+        .await
+        .is_err()
+    );
+    assert!(rx_sub.is_empty());
+    let mut init = codex_extension_api::ExtensionDataInit::default();
+    init.insert(crate::agent_workflow_managed::AgentWorkflowCallbackTurn(
+        "prior-turn".into(),
+    ));
+    io.submit(WithTurnExtensionData::new(
+        Op::DynamicToolResponse {
+            id: "prior-call".into(),
+            response,
+        },
+        init,
+    ))
+    .await
+    .expect("bound old callback enters actual submission queue");
+    let mut submissions = Box::pin(tokio::task::unconstrained(submission_loop(
+        Arc::clone(&session),
+        Arc::clone(&turn.config),
+        rx_sub,
+    )));
+    // Execute the actual queued handler, then wait at the next empty receive.
+    assert!(futures::poll!(submissions.as_mut()).is_pending());
+    assert_eq!(io.tx_sub.len(), 0);
+    assert_eq!(runtime.model_tasks_for_test(), 1);
+    assert!(
+        session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .expect("later turn")
+            .task
+            .as_ref()
+            .expect("later task")
+            .managed_lifecycle
+            .as_ref()
+            .expect("actual later lifecycle guard")
+            .is_admitted(),
+        "late prior response must not revoke the later managed generation"
+    );
+    assert_eq!(
+        session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .expect("later turn retained")
+            .task
+            .as_ref()
+            .expect("later task retained")
+            .turn_context
+            .sub_id,
+        turn.sub_id
+    );
+    assert!(
+        runtime
+            .begin("thread".into(), "probe".into(), "probe".into())
+            .err()
+            .expect("original remains held")
+            .to_string()
+            .contains("requires recovery hold")
+    );
+    // A terminal result after release proves the later task was never cancelled
+    // or revoked by the prior callback; the complete guard must still join.
+    release.notify_one();
+    timeout(StdDuration::from_secs(2), async {
+        loop {
+            let event = events.recv().await.expect("later terminal channel open");
+            if event.id == turn.sub_id {
+                match event.msg {
+                    EventMsg::TurnAborted(_) => panic!("prior callback cancelled the later turn"),
+                    EventMsg::TurnComplete(_) => break,
+                    _ => {}
+                }
+            }
+        }
+    })
+    .await
+    .expect("later task completes without cancellation");
+    timeout(StdDuration::from_secs(2), runtime.join_work())
+        .await
+        .expect("later guard completes");
+    assert!(session.active_turn.lock().await.is_none());
+    drop(submissions);
+}
