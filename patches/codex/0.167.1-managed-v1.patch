+    fn entire_batch_permit_and_results_precede_any_source_delivery() {
+        let (runtime, _guard) = planned();
+        let usage = codex_protocol::protocol::TokenUsage::default();
+        assert!(
+            runtime
+                .model_witness("prior-turn", "reported-response", &usage)
+                .is_err()
+        );
+        assert_eq!(
+            runtime
+                .model_witness("turn", "reported-response", &usage)
+                .unwrap()
+                .batch
+                .turn_id,
+            "turn"
+        );
+        let (permit, _work) = parked(&runtime);
+        // Original-turn ownership is checked before receipt mutation: even an
+        // otherwise valid permit from a delayed producer cannot erase this batch.
+        assert!(
+            runtime
+                .accept_result_for_turn("prior-turn", "a", response(&permit))
+                .is_err()
+        );
+        // Reordered results are buffered. Neither first result nor a duplicate
+        // can resolve a single callback channel before the complete batch.
+        assert!(
+            runtime
+                .accept_result("b", response(&permit))
+                .unwrap()
+                .is_empty()
+        );
+        let ready = runtime.accept_result("a", response(&permit)).unwrap();
+        assert_eq!(
+            ready.iter().map(|(id, _)| id.as_str()).collect::<Vec<_>>(),
+            vec!["a", "b"]
+        );
+        assert!(runtime.accept_result("a", response(&permit)).is_err());
+    }
