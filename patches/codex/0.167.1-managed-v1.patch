+#[tokio::test]
+async fn managed_source_external_abort_tail_fences_graceful_and_forced_successors() {
+    for forced in [false, true] {
+        let (mut session, original, events) = make_session_and_context_with_rx().await;
+        attach_thread_persistence(Arc::get_mut(&mut session).expect("unique owned Session")).await;
+        let runtime = managed_source_runtime(&session);
+        original
+            .extension_data
+            .insert(crate::AgentWorkflowInvocation("original-abort".into()));
+        let started = Arc::new(Notify::new());
+        let stopped = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let abort_entered = Arc::new(Notify::new());
+        let abort_release = Arc::new(Notify::new());
+        timeout(
+            StdDuration::from_secs(2),
+            session.start_task(
+                Arc::clone(&original),
+                Vec::new(),
+                ManagedSourceAbortTailTask {
+                    forced,
+                    started: Arc::clone(&started),
+                    stopped: Arc::clone(&stopped),
+                    abort_entered: Arc::clone(&abort_entered),
+                    abort_release: Arc::clone(&abort_release),
+                },
+            ),
+        )
+        .await
+        .expect("original setup deadline");
+        timeout(StdDuration::from_secs(2), started.notified())
+            .await
+            .expect("actual original run started");
+        let abort_session = Arc::clone(&session);
+        let original_id = original.sub_id.clone();
+        let mut aborting = tokio_util::task::AbortOnDropHandle::new(tokio::spawn(async move {
+            // Exercise the off-submission original-turn callback cancellation path.
+            abort_session
+                .abort_turn_if_active(&original_id, TurnAbortReason::Interrupted, None)
+                .await
+        }));
+        timeout(StdDuration::from_secs(2), abort_entered.notified())
+            .await
+            .expect("actual external abort tail entered");
+        assert!(stopped.load(std::sync::atomic::Ordering::Acquire));
+        assert!(session.active_turn.lock().await.is_none());
+        assert_eq!(
+            runtime.model_tasks_for_test(),
+            1,
+            "joined run retains its full abort lifecycle guard"
+        );
+        let (_unused, mut successor) = make_session_and_context().await;
+        successor.sub_id = if forced {
+            "after-forced-abort"
+        } else {
+            "after-graceful-abort"
+        }
+        .into();
+        let successor_id = successor.sub_id.clone();
+        successor
+            .extension_data
+            .insert(crate::AgentWorkflowInvocation(
+                "successor-after-abort".into(),
+            ));
+        let polled = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let next_started = Arc::new(Notify::new());
+        let next_release = Arc::new(Notify::new());
+        let next_session = Arc::clone(&session);
+        let task = ManagedSourceTask {
+            polled: Arc::clone(&polled),
+            started: Arc::clone(&next_started),
+            release: Arc::clone(&next_release),
+        };
+        let mut setup = tokio_util::task::AbortOnDropHandle::new(tokio::spawn(async move {
+            next_session
+                .start_task(Arc::new(successor), Vec::new(), task)
+                .await;
+        }));
+        timeout(StdDuration::from_secs(2), async {
+            while runtime.model_tasks_for_test() != 2 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("successor registration remains counted");
+        assert!(!polled.load(std::sync::atomic::Ordering::Acquire));
+        let mut joined = Box::pin(runtime.join_work());
+        assert!(futures::poll!(joined.as_mut()).is_pending());
+        abort_release.notify_one();
+        assert!(
+            timeout(StdDuration::from_secs(2), &mut aborting)
+                .await
+                .expect("abort must not join its own or the successor guard")
+                .expect("abort task panic")
+        );
+        timeout(StdDuration::from_secs(2), &mut setup)
+            .await
+            .expect("successor setup deadline")
+            .expect("successor setup panic");
+        timeout(StdDuration::from_secs(2), next_started.notified())
+            .await
+            .expect("successor generation remains admitted");
+        // The terminal event and actual rollout flush precede lifecycle release.
+        timeout(StdDuration::from_secs(2), async {
+            loop {
+                let event = events.recv().await.expect("terminal event channel open");
+                if event.id == successor_id && matches!(event.msg, EventMsg::TurnStarted(_)) {
+                    panic!("successor started before the original abort terminal event");
+                }
+                if event.id == original.sub_id && matches!(event.msg, EventMsg::TurnAborted(_)) {
+                    break;
+                }
+            }
+        })
+        .await
+        .expect("original abort terminal event deadline");
+        assert_eq!(runtime.model_tasks_for_test(), 1);
+        assert!(
+            session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .expect("successor turn")
+                .task
+                .as_ref()
+                .expect("successor task")
+                .managed_lifecycle
+                .as_ref()
+                .expect("successor lifecycle")
+                .is_admitted()
+        );
+        assert!(futures::poll!(joined.as_mut()).is_pending());
+        next_release.notify_one();
+        timeout(StdDuration::from_secs(2), joined)
+            .await
+            .expect("both full lifecycles joined");
+        assert!(session.active_turn.lock().await.is_none());
+    }
+}
