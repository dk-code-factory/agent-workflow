diff --git a/codex-rs/core/src/agent_workflow_managed.rs b/codex-rs/core/src/agent_workflow_managed.rs
new file mode 100644
index 0000000..65863a4
--- /dev/null
+++ b/codex-rs/core/src/agent_workflow_managed.rs
@@ -0,0 +1,806 @@
+//! Repository-owned managed profile. Stock sessions retain their native policy.
+//! All checks run before spawning session work; unknown history cannot acquire it.
+
+use crate::thread_manager::StartThreadOptions;
+use codex_extension_api::SessionIsolation;
+use codex_extension_api::ToolName;
+use codex_extension_api::ToolPolicy;
+use codex_features::Feature;
+use codex_history::InitialHistory;
+use codex_history::RolloutItem;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::protocol::AgentWorkflowParkedBatch;
+use codex_protocol::protocol::AgentWorkflowPolicy;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+/// Source-owned accounting for the deliberately broker-only execution profile.
+pub struct AgentWorkflowRuntime {
+    policy: AgentWorkflowPolicy,
+    batch: Mutex<Option<Batch>>,
+    invocation: Mutex<Option<(String, String)>>,
+    active_work: AtomicUsize,
+    active_tasks: AtomicUsize,
+    generation: AtomicU64,
+    model_generation: AtomicU64,
+    work_finished: tokio::sync::Notify,
+}
+
+pub(crate) struct ManagedWorkGuard {
+    runtime: Arc<AgentWorkflowRuntime>,
+    pub(crate) admitted: bool,
+    model: bool,
+    generation: u64,
+}
+
+impl ManagedWorkGuard {
+    pub(crate) fn is_admitted(&self) -> bool {
+        self.admitted && self.runtime.generation.load(Ordering::Acquire) == self.generation
+    }
+}
+
+impl Drop for ManagedWorkGuard {
+    fn drop(&mut self) {
+        let counter = if self.model {
+            &self.runtime.active_tasks
+        } else {
+            &self.runtime.active_work
+        };
+        if counter.fetch_sub(1, Ordering::AcqRel) == 1 {
+            self.runtime.work_finished.notify_waiters();
+        }
+    }
+}
+
+/// Required for each engine-owned turn; not restored from thread history.
+#[derive(Clone, Debug)]
+pub struct AgentWorkflowInvocation(pub String);
+
+struct Batch {
+    identity: AgentWorkflowParkedBatch,
+    planned: BTreeSet<String>,
+    parked: BTreeSet<String>,
+    published: BTreeSet<String>,
+    sealed: bool,
+    attested: bool,
+    delivered: bool,
+    results: BTreeMap<String, DynamicToolResponse>,
+}
+
+pub(crate) struct BatchGuard {
+    runtime: Arc<AgentWorkflowRuntime>,
+    id: String,
+}
+
+impl Drop for BatchGuard {
+    fn drop(&mut self) {
+        let mut state = self.runtime.batch.lock().unwrap();
+        if state
+            .as_ref()
+            .is_some_and(|batch| batch.identity.batch_id == self.id)
+        {
+            *state = None;
+        }
+    }
+}
+
+impl AgentWorkflowRuntime {
+    /// Synchronously revoke every outstanding permit before joining turn work.
+    pub fn invalidate(&self) {
+        let mut batch = self.batch.lock().unwrap();
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        *batch = None;
+    }
+
+    /// Register before spawning, including a task that will reject invalid work.
+    pub(crate) fn scheduled(self: &Arc<Self>, call: &str) -> ManagedWorkGuard {
+        let batch = self.batch.lock().unwrap();
+        let admitted = batch
+            .as_ref()
+            .is_some_and(|batch| batch.sealed && batch.planned.contains(call));
+        let generation = self.generation.load(Ordering::Acquire);
+        self.active_work.fetch_add(1, Ordering::AcqRel);
+        ManagedWorkGuard {
+            runtime: Arc::clone(self),
+            admitted,
+            model: false,
+            generation,
+        }
+    }
+
+    pub(crate) fn model_scheduled(self: &Arc<Self>) -> ManagedWorkGuard {
+        let _batch = self.batch.lock().unwrap();
+        let generation = self.generation.load(Ordering::Acquire);
+        self.model_generation.store(generation, Ordering::Release);
+        self.active_tasks.fetch_add(1, Ordering::AcqRel);
+        ManagedWorkGuard {
+            runtime: Arc::clone(self),
+            admitted: true,
+            model: true,
+            generation,
+        }
+    }
+
+    /// The caller first joins the model task so no new deferred dispatch can
+    /// schedule work; then independently spawned dispatch tasks must all exit.
+    pub async fn join_work(&self) {
+        loop {
+            let notified = self.work_finished.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.active_work.load(Ordering::Acquire) == 0
+                && self.active_tasks.load(Ordering::Acquire) == 0
+            {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    fn new(policy: AgentWorkflowPolicy) -> Self {
+        Self {
+            policy,
+            batch: Mutex::new(None),
+            invocation: Mutex::new(None),
+            active_work: AtomicUsize::new(0),
+            active_tasks: AtomicUsize::new(0),
+            generation: AtomicU64::new(0),
+            model_generation: AtomicU64::new(0),
+            work_finished: tokio::sync::Notify::new(),
+        }
+    }
+
+    pub(crate) fn begin(
+        self: &Arc<Self>,
+        thread: String,
+        turn: String,
+        invocation: String,
+    ) -> Result<BatchGuard> {
+        if invocation.is_empty()
+            || invocation.len() > 256
+            || !invocation
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))
+        {
+            return Err(invalid("missing or invalid engine invocation identity"));
+        }
+        let mut state = self.batch.lock().unwrap();
+        if state.is_some()
+            || self.active_work.load(Ordering::Acquire) != 0
+            || self.active_tasks.load(Ordering::Acquire) != 1
+            || self.model_generation.load(Ordering::Acquire)
+                != self.generation.load(Ordering::Acquire)
+        {
+            return Err(invalid("a prior model batch is still live"));
+        }
+        let mut bound = self.invocation.lock().unwrap();
+        if bound
+            .as_ref()
+            .is_some_and(|(id, previous)| *id == invocation && *previous != turn)
+        {
+            return Err(invalid("a new turn cannot inherit an earlier invocation"));
+        }
+        *bound = Some((invocation.clone(), turn.clone()));
+        let id = uuid::Uuid::new_v4().to_string();
+        *state = Some(Batch {
+            identity: AgentWorkflowParkedBatch {
+                thread_id: thread,
+                turn_id: turn,
+                invocation_id: invocation,
+                policy_id: self.policy.policy_id.clone(),
+                build_id: self.policy.build_id.clone(),
+                batch_id: id.clone(),
+                response_id: String::new(),
+                call_ids: Vec::new(),
+            },
+            planned: BTreeSet::new(),
+            parked: BTreeSet::new(),
+            published: BTreeSet::new(),
+            sealed: false,
+            attested: false,
+            delivered: false,
+            results: BTreeMap::new(),
+        });
+        Ok(BatchGuard {
+            runtime: Arc::clone(self),
+            id,
+        })
+    }
+
+    pub(crate) fn plan(&self, call: &str, tool: &ToolName) -> Result<()> {
+        if !tool.is_default_namespace() || !self.policy.broker_tools.contains(&tool.name) {
+            return Err(invalid("ungranted tool emitted by model"));
+        }
+        let mut state = self.batch.lock().unwrap();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if batch.planned.len() >= 128
+            || batch.sealed
+            || call.is_empty()
+            || call.len() > 256
+            || !batch.planned.insert(call.to_owned())
+        {
+            return Err(invalid("late, empty or duplicate planned tool identity"));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn seal(&self, response_id: String) -> Result<()> {
+        let mut state = self.batch.lock().unwrap();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if batch.sealed || response_id.is_empty() {
+            return Err(invalid("incomplete or duplicate model batch seal"));
+        }
+        batch.identity.response_id = response_id;
+        batch.identity.call_ids = batch.planned.iter().cloned().collect();
+        batch.sealed = true;
+        Ok(())
+    }
+
+    pub(crate) fn park(&self, call: &str) -> Result<()> {
+        let mut state = self.batch.lock().unwrap();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if !batch.sealed || !batch.planned.contains(call) || !batch.parked.insert(call.to_owned()) {
+            return Err(invalid("unsealed, unknown or duplicate parked callback"));
+        }
+        Ok(())
+    }
+
+    /// Called after the app-server has queued this call's public RPC request.
+    /// No attestation exists until every deferred future is both parked and published.
+    pub fn published(&self, call: &str) -> Result<Option<AgentWorkflowParkedBatch>> {
+        let mut state = self.batch.lock().unwrap();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if !batch.parked.contains(call) || !batch.published.insert(call.to_owned()) {
+            return Err(invalid("unknown or duplicate published callback"));
+        }
+        if batch.sealed
+            && !batch.attested
+            && !batch.planned.is_empty()
+            && batch.planned == batch.parked
+            && batch.planned == batch.published
+            && self.active_work.load(Ordering::Acquire) == batch.planned.len()
+            && self.active_tasks.load(Ordering::Acquire) == 1
+            && self.model_generation.load(Ordering::Acquire)
+                == self.generation.load(Ordering::Acquire)
+        {
+            batch.attested = true;
+            return Ok(Some(batch.identity.clone()));
+        }
+        Ok(None)
+    }
+
+    pub(crate) fn accept_result(
+        &self,
+        call: &str,
+        mut response: DynamicToolResponse,
+    ) -> Result<Vec<(String, DynamicToolResponse)>> {
+        let mut state = self.batch.lock().unwrap();
+        let batch = state
+            .as_mut()
+            .ok_or_else(|| invalid("no live parked batch"))?;
+        let permit = response.agent_workflow_permit.take();
+        if !batch.attested
+            || batch.delivered
+            || permit.as_ref() != Some(&batch.identity)
+            || !batch.planned.contains(call)
+            || batch.results.contains_key(call)
+        {
+            *state = None;
+            return Err(invalid(
+                "early, changed, duplicate or stale batch permit/result",
+            ));
+        }
+        batch.results.insert(call.to_owned(), response);
+        if batch.results.len() != batch.planned.len() {
+            return Ok(Vec::new());
+        }
+        batch.delivered = true;
+        Ok(std::mem::take(&mut batch.results).into_iter().collect())
+    }
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!("agent-workflow managed policy: {message}"))
+}
+
+fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn validate_catalog(policy: &AgentWorkflowPolicy, tools: &[DynamicToolSpec]) -> Result<()> {
+    if policy.broker_tools.len() > 128 || tools.len() > 128 {
+        return Err(invalid("managed catalog exceeds 128 tools"));
+    }
+    let mut names = BTreeSet::new();
+    for name in &policy.broker_tools {
+        let Some(suffix) = name.strip_prefix("broker_") else {
+            return Err(invalid("only engine broker wire names are permitted"));
+        };
+        if !hex(suffix, 24) || !names.insert(name.as_str()) {
+            return Err(invalid("invalid or duplicate broker tool name"));
+        }
+    }
+    if !policy.broker_tools.windows(2).all(|pair| pair[0] < pair[1]) {
+        return Err(invalid("broker tool ceiling must use canonical ordering"));
+    }
+    let mut actual = BTreeSet::new();
+    for tool in tools {
+        let DynamicToolSpec::Function(tool) = tool else {
+            return Err(invalid("broker namespace containers are unsupported"));
+        };
+        if tool.defer_loading || !actual.insert(tool.name.as_str()) {
+            return Err(invalid("duplicate or deferred broker definition"));
+        }
+    }
+    if actual != names {
+        return Err(invalid(
+            "dynamic tool catalog differs from the exact ceiling",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn configure_start(options: &mut StartThreadOptions) -> Result<()> {
+    let supplied = options.thread_extension_init.get::<AgentWorkflowPolicy>();
+    let retained = options
+        .initial_history
+        .get_rollout_items()
+        .iter()
+        .find_map(|item| {
+            let RolloutItem::SessionMeta(meta) = item else {
+                return None;
+            };
+            Some(&meta.meta)
+        });
+    let retained_policy = retained.and_then(|meta| meta.agent_workflow_policy.as_ref());
+    if matches!(options.initial_history, InitialHistory::Forked(_))
+        && (supplied.is_some() || retained_policy.is_some())
+    {
+        return Err(invalid(
+            "managed forks and native children are not supported",
+        ));
+    }
+    match &options.initial_history {
+        InitialHistory::Resumed(_) if supplied.as_deref() != retained_policy => {
+            return Err(invalid("cold resume must retain the exact creation policy"));
+        }
+        _ => {}
+    }
+    let Some(policy) = supplied else {
+        return Ok(());
+    };
+    if options
+        .initial_history
+        .get_resumed_parent_thread_id()
+        .is_some()
+        || matches!(
+            options.session_source,
+            Some(codex_protocol::protocol::SessionSource::SubAgent(_))
+        )
+    {
+        return Err(invalid("native managed descendants are not supported"));
+    }
+    if !matches!(policy.protocol, 1) || !hex(&policy.policy_id, 64) {
+        return Err(invalid("unsupported policy protocol or identity"));
+    }
+    let expected_build = option_env!("AGENT_WORKFLOW_CODEX_BUILD_ID");
+    if !hex(&policy.build_id, 64) || expected_build != Some(policy.build_id.as_str()) {
+        return Err(invalid("policy requires its exact verified source build"));
+    }
+    if options
+        .initial_history
+        .get_selected_capability_roots()
+        .len()
+        > 0
+        || options
+            .thread_extension_init
+            .get::<Vec<codex_protocol::capabilities::SelectedCapabilityRoot>>()
+            .is_some_and(|roots| !roots.is_empty())
+    {
+        return Err(invalid(
+            "this profile has no selected-skill capability proof",
+        ));
+    }
+    let tools = if matches!(options.initial_history, InitialHistory::Resumed(_)) {
+        let original = retained
+            .and_then(|meta| meta.dynamic_tools.clone())
+            .unwrap_or_default();
+        let latest = options
+            .initial_history
+            .get_dynamic_tools()
+            .unwrap_or_default();
+        if latest != original || !options.dynamic_tools.is_empty() {
+            return Err(invalid("managed dynamic catalog cannot change on resume"));
+        }
+        original
+    } else {
+        options.dynamic_tools.clone()
+    };
+    validate_catalog(&policy, &tools)?;
+    // Admission precedes Session::new: ambient native initialization is not
+    // accounted broker work, even when its eventual tools would be filtered.
+    for feature in [
+        Feature::ShellSnapshot,
+        Feature::ShellSnapshotV2,
+        Feature::Apps,
+        Feature::Plugins,
+        Feature::RecommendedPlugins,
+        Feature::ToolSuggest,
+        Feature::ExecutorCapabilityDiscovery,
+        Feature::ExecutorCapabilityDiscoveryV2,
+        Feature::CodeMode,
+        Feature::CodeModeHost,
+        Feature::CodeModePrewarm,
+        Feature::CodeModeOnly,
+    ] {
+        options
+            .config
+            .features
+            .set_enabled(feature, false)
+            .map_err(|_| invalid("managed startup conflicts with required native feature"))?;
+        if options.config.features.enabled(feature) {
+            return Err(invalid("managed startup cannot retain a native feature"));
+        }
+    }
+    options
+        .thread_extension_init
+        .insert(crate::McpServersDisabled);
+    options.config.memories.generate_memories = false;
+    options.config.memories.use_memories = false;
+    options
+        .thread_extension_init
+        .insert(AgentWorkflowRuntime::new(policy.as_ref().clone()));
+    options
+        .thread_extension_init
+        .insert(SessionIsolation::Isolated);
+    options.thread_extension_init.insert(ToolPolicy {
+        allowed_tools: Some(
+            policy
+                .broker_tools
+                .iter()
+                .map(|name| ToolName::new(None, name.as_str()))
+                .collect(),
+        ),
+        require_managed_sandbox: false,
+        require_unified_exec: true,
+        expose_additional_permissions: false,
+    });
+    Ok(())
+}
