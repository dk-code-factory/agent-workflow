+#[tokio::test]
+async fn managed_source_incomplete_usage_survives_revocation_without_completing_intent() {
+    for revoked in [false, true] {
+        let (mut session, turn) = make_session_and_context().await;
+        let rollout = attach_thread_persistence(&mut session).await;
+        let runtime = managed_source_runtime(&session);
+        let model = runtime.model_scheduled();
+        let batch = runtime
+            .begin(
+                session.thread_id.to_string(),
+                turn.sub_id.clone(),
+                "incomplete-invocation".into(),
+            )
+            .expect("original model batch");
+        runtime
+            .start_model_intent(&rollout)
+            .expect("original durable started intent");
+        if revoked {
+            runtime.invalidate();
+        }
+        let usage = TokenUsage {
+            input_tokens: 17,
+            output_tokens: 5,
+            total_tokens: 22,
+            ..Default::default()
+        };
+        let turn = Arc::new(turn);
+        let step = StepContext::for_test(Arc::clone(&turn));
+        timeout(
+            StdDuration::from_secs(2),
+            session.record_incomplete_response_usage(
+                &turn,
+                &step.settings,
+                &ResponseIncompleteError {
+                    partial_output: Vec::new(),
+                    reason: "max_output_tokens".into(),
+                    response_id: Some("reported-incomplete-response".into()),
+                    token_usage: Some(usage.clone()),
+                },
+            ),
+        )
+        .await
+        .expect("actual incomplete accounting producer deadline");
+        session
+            .flush_rollout()
+            .await
+            .expect("persist reported incomplete spending");
+        let (items, _, errors) = RolloutRecorder::load_rollout_items(&rollout)
+            .await
+            .expect("read actual usage record");
+        assert_eq!(errors, 0);
+        let records = items
+            .iter()
+            .filter_map(|item| match item {
+                RolloutItem::TokenUsageRecord(record) => Some(record),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(records.len(), 1);
+        assert_eq!(
+            records[0].usage, usage,
+            "reported spending is preserved exactly"
+        );
+        assert_eq!(records[0].thread_token_usage, usage);
+        assert_eq!(records[0].turn_token_usage, usage);
+        assert_eq!(records[0].turn_id, turn.sub_id);
+        assert_eq!(records[0].response_id, "reported-incomplete-response");
+        if revoked {
+            assert!(
+                records[0].agent_workflow_witness.is_none(),
+                "revoked usage retains spending and original record identity without fabricated authority"
+            );
+        } else {
+            let witness = records[0]
+                .agent_workflow_witness
+                .as_ref()
+                .expect("reported response identity witness");
+            assert_eq!(witness.batch.turn_id, turn.sub_id);
+            assert_eq!(witness.batch.invocation_id, "incomplete-invocation");
+            assert_eq!(witness.batch.response_id, "reported-incomplete-response");
+            assert_eq!(
+                witness.usage,
+                serde_json::to_value(&usage).expect("known usage")
+            );
+        }
+        let intent: serde_json::Value = serde_json::from_slice(
+            &tokio::fs::read(rollout.with_extension("managed-model.json"))
+                .await
+                .expect("original durable intent"),
+        )
+        .expect("intent JSON");
+        assert!(
+            intent["completed"].is_null(),
+            "usage witness cannot assert actual Completed or seal an intent"
+        );
+        assert_eq!(intent["started"]["turnId"], turn.sub_id);
+        assert_eq!(intent["started"]["invocationId"], "incomplete-invocation");
+        assert!(!rollout.with_extension("managed-broker.json").exists());
+        drop(batch);
+        drop(model);
+        let probe = runtime.model_scheduled();
+        assert!(
+            runtime
+                .begin(
+                    "thread".into(),
+                    "later-turn".into(),
+                    "later-invocation".into()
+                )
+                .err()
+                .expect("unknown original remains held")
+                .to_string()
+                .contains("requires recovery hold")
+        );
+        drop(probe);
+        timeout(StdDuration::from_secs(2), runtime.join_work())
+            .await
+            .expect("incomplete source guards joined");
+    }
+}
