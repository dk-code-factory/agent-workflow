+#[tokio::test]
+async fn managed_source_sampling_incomplete_publishes_known_usage_before_error() {
+    let (mut session, turn, events) = make_session_and_context_with_rx().await;
+    let rollout = attach_thread_persistence(
+        Arc::get_mut(&mut session).expect("unique owned sampling Session"),
+    )
+    .await;
+    let runtime = managed_source_runtime(&session);
+    let model = runtime.model_scheduled();
+    turn.extension_data
+        .insert(crate::AgentWorkflowInvocation("sampled-incomplete".into()));
+    let usage = TokenUsage {
+        input_tokens: 23,
+        output_tokens: 7,
+        total_tokens: 30,
+        ..Default::default()
+    };
+    let (tx, rx_event) = tokio::sync::mpsc::channel(1);
+    tx.try_send(Err(CodexErr::new(CodexErrorDetails::ResponseIncomplete(
+        Box::new(ResponseIncompleteError {
+            partial_output: Vec::new(),
+            reason: "max_output_tokens".into(),
+            response_id: Some("sampled-incomplete-response".into()),
+            token_usage: Some(usage.clone()),
+        }),
+    ))))
+    .expect("owned in-memory incomplete response");
+    drop(tx);
+    let consumer_dropped = CancellationToken::new();
+    let stream = crate::ResponseStream {
+        routing_affinity: None,
+        rx_event,
+        interrupt: None,
+        consumer_dropped: consumer_dropped.clone(),
+    };
+    let result = timeout(
+        StdDuration::from_secs(2),
+        super::turn::sample_managed_source_response_for_test(
+            Arc::clone(&session),
+            Arc::clone(&turn),
+            stream,
+        ),
+    )
+    .await
+    .expect("actual single sampling attempt deadline");
+    let error = result.expect_err("incomplete error remains the sampling result");
+    assert!(
+        matches!(error.details(), CodexErrorDetails::ResponseIncomplete(incomplete)
+        if incomplete.response_id.as_deref() == Some("sampled-incomplete-response")
+        && incomplete.token_usage.as_ref() == Some(&usage))
+    );
+    assert!(
+        consumer_dropped.is_cancelled(),
+        "actual sampling consumer releases the stream"
+    );
+    let mut notifications = 0;
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::TokenCount(count) => {
+                assert_eq!(event.id, turn.sub_id);
+                assert!(
+                    count.agent_workflow_witness.is_none(),
+                    "incomplete spending cannot emit Completed authority"
+                );
+                let info = count.info.expect("public native usage totals");
+                assert_eq!(info.total_token_usage, usage);
+                notifications += 1;
+            }
+            EventMsg::RawResponseCompleted(_) => {
+                panic!("incomplete response cannot become Completed")
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        notifications, 1,
+        "known usage is public before returning the original error"
+    );
+    session
+        .flush_rollout()
+        .await
+        .expect("persist actual incomplete sampling usage");
+    let (items, _, errors) = RolloutRecorder::load_rollout_items(&rollout)
+        .await
+        .expect("read sampled usage");
+    assert_eq!(errors, 0);
+    let records = items
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::TokenUsageRecord(record) => Some(record),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0].usage, usage);
+    assert_eq!(records[0].turn_id, turn.sub_id);
+    assert_eq!(records[0].response_id, "sampled-incomplete-response");
+    let intent: serde_json::Value = serde_json::from_slice(
+        &tokio::fs::read(rollout.with_extension("managed-model.json"))
+            .await
+            .expect("original sampled intent"),
+    )
+    .expect("intent JSON");
+    assert!(intent["completed"].is_null());
+    assert!(!rollout.with_extension("managed-broker.json").exists());
+    drop(model);
+    let probe = runtime.model_scheduled();
+    assert!(
+        runtime
+            .begin(
+                "thread".into(),
+                "later-turn".into(),
+                "later-invocation".into()
+            )
+            .err()
+            .expect("incomplete original is held")
+            .to_string()
+            .contains("requires recovery hold")
+    );
+    drop(probe);
+    timeout(StdDuration::from_secs(2), runtime.join_work())
+        .await
+        .expect("sampling guards joined");
+}
