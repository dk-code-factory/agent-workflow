+pub(crate) fn read_raw_rollout(path: &Path) -> std::io::Result<RawRollout> {
+    const MAX_RAW_BYTES: usize = 64 * 1024 * 1024;
+    let mut file = open_regular(path, false)?;
+    if file.metadata()?.len() > MAX_RAW_BYTES as u64 {
+        return Err(invalid("raw rollout exceeds managed recovery bound"));
+    }
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file)
+        .take((MAX_RAW_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_RAW_BYTES || bytes.last() != Some(&b'\n') {
+        return Err(invalid(
+            "oversized, missing or partial original raw rollout",
+        ));
+    }
+    let mut items = Vec::new();
+    let mut responses = Vec::new();
+    for line in bytes
+        .split(|byte| *byte == b'\n')
+        .filter(|line| !line.is_empty())
+    {
+        let decoded =
+            codex_rollout::parse_rollout_line_bytes(line).map_err(std::io::Error::other)?;
+        if let codex_history::RolloutItem::ResponseItem(envelope) = &decoded.item {
+            responses.push(envelope.item.clone());
+        }
+        items.push(decoded.item);
+    }
+    Ok(RawRollout { items, responses })
+}
+
+/// This is additional to, and ordered AFTER, upstream LiveThread.flush().
+/// No storage guarantee is inferred from that buffered writer method's name.
+pub(crate) fn sync_raw_rollout(path: &Path) -> std::io::Result<()> {
+    check_parents(path)?;
+    open_regular(path, false)?.sync_all()?;
+    sync_directory(
+        path.parent()
+            .ok_or_else(|| invalid("rollout parent absent"))?,
+    )
+}
+
+trait LinkCount {
+    fn nlink_checked(&self) -> u64;
+}
+impl LinkCount for std::fs::Metadata {
+    fn nlink_checked(&self) -> u64 {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            self.nlink()
+        }
+        #[cfg(not(unix))]
+        {
+            0
+        }
+    }
+}
+
+fn check_parents(path: &Path) -> std::io::Result<()> {
+    let mut current = path.parent().ok_or_else(|| invalid("path parent absent"))?;
+    loop {
+        let metadata = std::fs::symlink_metadata(current)?;
+        if !metadata.is_dir() || metadata.file_type().is_symlink() {
+            return Err(invalid("non-directory or aliased persistence parent"));
+        }
+        match current.parent() {
+            Some(parent) => current = parent,
+            None => return Ok(()),
+        }
+    }
+}
+
+fn open_regular(path: &Path, write: bool) -> std::io::Result<File> {
+    check_parents(path)?;
+    let mut options = OpenOptions::new();
+    options.read(true).write(write);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    #[cfg(not(unix))]
+    {
+        return Err(invalid(
+            "managed journal requires supported Unix file barriers",
+        ));
+    }
+    let file = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.file_type().is_file() || metadata.nlink_checked() != 1 {
+        return Err(invalid(
+            "persistence is not an exclusively owned regular file",
+        ));
+    }
+    Ok(file)
+}
+
+/// A first seal may follow lazy creation of several native rollout directory
+/// levels. Sync each entry's containing directory once per live thread, from
+/// inner to outer; later journal renames only need their immediate parent sync.
+pub(crate) fn sync_parent_entries_once(
+    path: &Path,
+    synced: &mut BTreeSet<PathBuf>,
+) -> std::io::Result<()> {
+    let mut parent = path
+        .parent()
+        .ok_or_else(|| invalid("rollout parent absent"))?;
+    for _ in 0..128 {
+        if !synced.contains(parent) {
+            sync_directory(parent)?;
+            synced.insert(parent.to_path_buf());
+        }
+        match parent.parent() {
+            Some(next) => parent = next,
+            None => return Ok(()),
+        }
+    }
+    Err(invalid("persistence directory ancestry exceeds bound"))
+}
+
+fn sync_directory(path: &Path) -> std::io::Result<()> {
+    let file = File::open(path)?;
+    if !file.metadata()?.is_dir() {
+        return Err(invalid("sync target is not a directory"));
+    }
+    file.sync_all()
+}
