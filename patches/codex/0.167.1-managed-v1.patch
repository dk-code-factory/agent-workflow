+// Installed only in the owned Session. The original abort lifecycle arms its
+// next flush, after the interrupted-marker flush and before terminal durability.
+pub(super) struct ManagedSourceTerminalFlush {
+    original_turn: String,
+    armed: std::sync::atomic::AtomicBool,
+    entered: Notify,
+    release: Notify,
+}
+
+impl ManagedSourceTerminalFlush {
+    pub(super) async fn before_flush(&self) -> std::io::Result<()> {
+        if self.armed.swap(false, std::sync::atomic::Ordering::AcqRel) {
+            self.entered.notify_one();
+            timeout(StdDuration::from_secs(5), self.release.notified())
+                .await
+                .map_err(|_| std::io::Error::other("owned terminal-flush gate deadline"))?;
+        }
+        Ok(())
+    }
+}
+
+impl codex_extension_api::TurnLifecycleContributor for ManagedSourceTerminalFlush {
+    fn on_turn_abort<'a>(
+        &'a self,
+        input: codex_extension_api::TurnAbortInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            assert_eq!(input.turn_store.level_id(), self.original_turn);
+            self.armed.store(true, std::sync::atomic::Ordering::Release);
+        })
+    }
+}
+
+struct ManagedSourceFlushRelease(Arc<ManagedSourceTerminalFlush>);
+impl Drop for ManagedSourceFlushRelease {
+    fn drop(&mut self) {
+        // A failed assertion cannot retain an owned flush waiter indefinitely.
+        self.0.release.notify_one();
+    }
+}
