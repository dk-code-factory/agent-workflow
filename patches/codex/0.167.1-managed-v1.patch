+struct ManagedSourceBeginProbe {
+    runtime: Arc<crate::AgentWorkflowRuntime>,
+    started: std::sync::Mutex<Option<tokio::sync::oneshot::Sender<Result<(), String>>>>,
+    release: Arc<Notify>,
+}
+
+impl SessionTask for ManagedSourceBeginProbe {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.managed_source_begin_probe"
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        let batch = self.runtime.begin(
+            session.thread_id.to_string(),
+            ctx.sub_id.clone(),
+            "successor-invocation".into(),
+        );
+        self.started
+            .lock()
+            .expect("probe sender mutex")
+            .take()
+            .expect("one probe poll")
+            .send(batch.as_ref().map(|_| ()).map_err(ToString::to_string))
+            .expect("probe receiver retained");
+        let _batch = batch?;
+        tokio::select! {
+            _ = self.release.notified() => Ok(None),
+            _ = cancellation.cancelled() => Err(CodexErr::TurnAborted),
+            _ = tokio::time::sleep(StdDuration::from_secs(5)) => {
+                Err(CodexErr::InvalidRequest("managed begin probe release deadline".into()))
+            }
+        }
+    }
+}
