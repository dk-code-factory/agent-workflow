+    const FIRST: &str = "broker_0123456789abcdef01234567";
+    const SECOND: &str = "broker_1123456789abcdef01234567";
+
+    struct TestTurnGuard {
+        _batch: BatchGuard,
+        _task: ManagedWorkGuard,
+    }
+
+    fn planned() -> (Arc<AgentWorkflowRuntime>, TestTurnGuard) {
+        let runtime = Arc::new(AgentWorkflowRuntime::new(policy(&[FIRST, SECOND])));
+        let task = runtime.model_scheduled();
+        let guard = runtime
+            .begin("thread".into(), "turn".into(), "engine-message".into())
+            .unwrap();
+        runtime.plan("a", &ToolName::new(None, FIRST)).unwrap();
+        runtime.plan("b", &ToolName::new(None, SECOND)).unwrap();
+        (
+            runtime,
+            TestTurnGuard {
+                _batch: guard,
+                _task: task,
+            },
+        )
+    }
+
+    fn parked(
+        runtime: &Arc<AgentWorkflowRuntime>,
+    ) -> (AgentWorkflowParkedBatch, Vec<ManagedWorkGuard>) {
+        runtime.seal("response".into()).unwrap();
+        let first = runtime.scheduled("a");
+        assert!(first.admitted);
+        runtime.park("a").unwrap();
+        assert!(runtime.published("a").unwrap().is_none());
+        // An unpolled planned future remains outstanding, even with an idle stream.
+        let second = runtime.scheduled("b");
+        assert!(second.admitted);
+        runtime.park("b").unwrap();
+        (
+            runtime.published("b").unwrap().unwrap(),
+            vec![first, second],
+        )
+    }
+
+    fn response(permit: &AgentWorkflowParkedBatch) -> DynamicToolResponse {
+        DynamicToolResponse {
+            agent_workflow_permit: Some(permit.clone()),
+            content_items: Vec::new(),
+            success: true,
+        }
+    }
+
+    #[test]
+    fn delayed_stream_and_planned_future_cannot_attest() {
+        let (runtime, _guard) = planned();
+        assert!(runtime.park("a").is_err());
+        assert!(runtime.published("a").is_err());
+        assert!(runtime.seal(String::new()).is_err());
+        let (attestation, _work) = parked(&runtime);
+        assert_eq!(attestation.call_ids, vec!["a", "b"]);
+        assert!(runtime.plan("late", &ToolName::new(None, FIRST)).is_err());
+        assert!(runtime.published("b").is_err());
+    }
+
+    #[test]
+    fn entire_batch_permit_and_results_precede_any_source_delivery() {
+        let (runtime, _guard) = planned();
+        let (permit, _work) = parked(&runtime);
+        // Reordered results are buffered. Neither first result nor a duplicate
+        // can resolve a single callback channel before the complete batch.
+        assert!(
+            runtime
+                .accept_result("b", response(&permit))
+                .unwrap()
+                .is_empty()
+        );
+        let ready = runtime.accept_result("a", response(&permit)).unwrap();
+        assert_eq!(
+            ready.iter().map(|(id, _)| id.as_str()).collect::<Vec<_>>(),
+            vec!["a", "b"]
+        );
+        assert!(runtime.accept_result("a", response(&permit)).is_err());
+    }
+
+    #[test]
+    fn invalid_or_duplicate_results_invalidate_the_entire_parked_batch() {
+        for change in ["missing", "batch", "invocation", "duplicate"] {
+            let (runtime, _guard) = planned();
+            let (permit, _work) = parked(&runtime);
+            let mut wrong = permit.clone();
+            match change {
+                "missing" => {
+                    wrong.call_ids.pop();
+                }
+                "batch" => wrong.batch_id.push('x'),
+                "invocation" => wrong.invocation_id.push('x'),
+                "duplicate" => {
+                    assert!(
+                        runtime
+                            .accept_result("a", response(&permit))
+                            .unwrap()
+                            .is_empty()
+                    );
+                }
+                _ => unreachable!(),
+            }
+            assert!(runtime.accept_result("a", response(&wrong)).is_err());
+            // There is no valid retry on the same batch after rejection. The
+            // source session handler interrupts on every such returned error.
+            assert!(runtime.accept_result("b", response(&permit)).is_err());
+        }
+    }
