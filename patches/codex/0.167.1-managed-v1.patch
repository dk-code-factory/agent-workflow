+            assert!(
+                runtime.begin_recovery(&original, &rollout).is_err(),
+                "{invalid}"
+            );
+            assert!(runtime.batch.lock().unwrap().is_none());
+        }
+        for stale_epoch in [true, false] {
+            let (_directory, rollout, policy, journal) = recovery_fixture(true);
+            let runtime = Arc::new(AgentWorkflowRuntime::new(policy));
+            runtime
+                .load_journal(&rollout, &journal.identity.thread_id)
+                .unwrap();
+            assert!(runtime.recovery_hold.load(Ordering::Acquire));
+            let task = runtime.model_scheduled();
+            let (guard, calls) = runtime.begin_recovery(&journal.identity, &rollout).unwrap();
+            assert_eq!(calls, journal.calls);
+            let work = runtime.scheduled("original-call");
+            runtime.park("original-call").unwrap();
+            let permit = runtime.published("original-call").unwrap().unwrap();
+            assert_eq!(permit.batch, journal.identity);
+            assert_eq!(permit.usage, journal.usage);
+            assert!(!permit.permit_epoch.is_empty());
+            let mut result = journal.results["original-call"].clone();
+            let mut control = permit.clone();
+            if stale_epoch {
+                control.permit_epoch.push('x');
+            }
+            result.agent_workflow_permit = Some(control);
+            let accepted = runtime.accept_result("original-call", result);
+            if stale_epoch {
+                assert!(accepted.is_err());
+                continue;
+            }
+            assert_eq!(accepted.unwrap().len(), 1);
+            let missing = runtime.recovered_outputs(&rollout).unwrap();
+            assert_eq!(missing.len(), 1);
+            let mut raw = std::fs::OpenOptions::new()
+                .append(true)
+                .open(&rollout)
+                .unwrap();
+            for item in missing {
+                use std::io::Write;
+                let line = codex_history::RolloutLine {
+                    timestamp: "2026-11-25T00:00:00Z".into(),
+                    ordinal: None,
+                    item: RolloutItem::ResponseItem(codex_history::ResponseItemEnvelope::new(item)),
+                };
+                writeln!(raw, "{}", serde_json::to_string(&line).unwrap()).unwrap();
+            }
+            runtime.complete_durable(&rollout).unwrap();
+            assert!(!runtime.recovery_hold.load(Ordering::Acquire));
+            drop(guard);
+            drop(work);
+            drop(task);
+            let _next_task = runtime.model_scheduled();
+            assert!(
+                runtime
+                    .begin(
+                        journal.identity.thread_id.clone(),
+                        "subsequent-turn".into(),
+                        "subsequent-message".into()
+                    )
+                    .is_ok()
+            );
+        }
+    }
+}
