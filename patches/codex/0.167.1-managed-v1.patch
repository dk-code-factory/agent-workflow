+    #[tokio::test]
+    async fn revocation_before_model_or_dispatch_poll_cannot_start_new_work() {
+        let runtime = Arc::new(AgentWorkflowRuntime::new(policy(&[FIRST])));
+        let model = runtime.model_scheduled();
+        runtime.invalidate();
+        assert!(!model.is_admitted());
+        assert!(
+            runtime
+                .begin("t".into(), "turn".into(), "invocation".into())
+                .is_err()
+        );
+        let joining = Arc::clone(&runtime);
+        let mut joined = tokio::spawn(async move { joining.join_work().await });
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), &mut joined)
+                .await
+                .is_err()
+        );
+        // Repeated revocation cannot turn an outstanding source task into joined work.
+        runtime.invalidate();
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), &mut joined)
+                .await
+                .is_err()
+        );
+        drop(model);
+        tokio::time::timeout(std::time::Duration::from_secs(1), joined)
+            .await
+            .unwrap()
+            .unwrap();
