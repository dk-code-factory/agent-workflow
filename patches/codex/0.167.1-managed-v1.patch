+        assert!(runtime.plan("a", &ToolName::new(None, FIRST)).is_err());
+        let (old, work) = parked(&runtime);
+        drop(guard);
+        assert!(runtime.accept_result("a", response(&old)).is_err());
+        assert!(
+            runtime
+                .begin("thread".into(), "new-turn".into(), "new-message".into())
+                .is_err()
