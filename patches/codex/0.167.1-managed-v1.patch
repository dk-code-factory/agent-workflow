+#[tokio::test]
+async fn managed_source_revoked_setup_retires_its_registered_turn() {
+    let (session, turn, events) = make_session_and_context_with_rx().await;
+    let runtime = managed_source_runtime(&session);
+    // Retain a cancelled predecessor's conservative hold while rejecting setup.
+    let prior_task = runtime.model_scheduled();
+    let prior_batch = runtime
+        .begin(
+            "thread".into(),
+            "prior-turn".into(),
+            "prior-invocation".into(),
+        )
+        .expect("prior original batch");
+    runtime
+        .plan(
+            "prior-call",
+            &codex_extension_api::ToolName::new(None, "broker_0123456789abcdef01234567"),
+        )
+        .expect("original planned callback");
+    runtime.invalidate();
+    drop(prior_batch);
+    drop(prior_task);
+    turn.extension_data
+        .insert(crate::AgentWorkflowInvocation("revoked-setup".into()));
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+    let polled = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let state = session.state.lock().await;
+    let task_session = Arc::clone(&session);
+    let task_turn = Arc::clone(&turn);
+    let task_polled = Arc::clone(&polled);
+    let mut setup = tokio_util::task::AbortOnDropHandle::new(tokio::spawn(async move {
+        task_session
+            .start_task(
+                task_turn,
+                Vec::new(),
+                ManagedSourceTask {
+                    polled: task_polled,
+                    started: Arc::new(Notify::new()),
+                    release: Arc::new(Notify::new()),
+                },
+            )
+            .await;
+    }));
+    managed_source_model_registered(&runtime).await;
+    runtime.invalidate();
+    let reservation = session
+        .active_turn
+        .lock()
+        .await
+        .take()
+        .expect("taskless reservation");
+    assert!(reservation.task.is_none());
+    drop(state);
+    timeout(StdDuration::from_secs(2), &mut setup)
+        .await
+        .expect("revoked setup completed")
+        .expect("setup did not panic");
+    let mut rejected = false;
+    timeout(StdDuration::from_secs(2), async {
+        loop {
+            let event = events.recv().await.expect("terminal event channel open");
+            if event.id != turn.sub_id {
+                continue;
+            }
+            match event.msg {
+                EventMsg::Error(error) => {
+                    assert!(error.message.contains("revoked before execution"));
+                    rejected = true;
+                }
+                EventMsg::TurnComplete(_) => break,
+                _ => {}
+            }
+        }
+    })
+    .await
+    .expect("revoked task terminal event deadline");
+    assert!(rejected);
+    assert!(!polled.load(std::sync::atomic::Ordering::Acquire));
+    timeout(StdDuration::from_secs(2), runtime.join_work())
+        .await
+        .expect("revoked setup and task guards joined without self-deadlock");
+    assert!(session.active_turn.lock().await.is_none());
+    let probe = runtime.model_scheduled();
+    let error = runtime
+        .begin(
+            "thread".into(),
+            "subsequent-turn".into(),
+            "subsequent-invocation".into(),
+        )
+        .err()
+        .expect("cancelled original remains held");
+    assert!(error.to_string().contains("requires recovery hold"));
+    drop(probe);
+}
