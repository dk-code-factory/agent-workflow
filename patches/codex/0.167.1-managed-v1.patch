@@ -0,0 +1,1562 @@
+//! Repository-owned managed profile. Stock sessions retain their native policy.
+//! All checks run before spawning session work; unknown history cannot acquire it.
+
+use crate::agent_workflow_journal::{
+    BrokerJournal, IntentFile, JournalFile, JournalPhase, ModelRequestIntent, OriginalCall,
+    read_raw_rollout, sync_raw_rollout,
+};
+use crate::thread_manager::StartThreadOptions;
+use codex_extension_api::SessionIsolation;
+use codex_extension_api::ToolName;
+use codex_extension_api::ToolPolicy;
+use codex_features::Feature;
+use codex_history::InitialHistory;
+use codex_history::RolloutItem;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::protocol::AgentWorkflowBatchPermit;
+use codex_protocol::protocol::AgentWorkflowParkedBatch;
+use codex_protocol::protocol::AgentWorkflowPolicy;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+// A poisoned authority mutex cannot be recovered without trusting partially
+// mutated policy, counters or durable receipt state. Preserve fail-closed panic
+// semantics rather than continuing with the poisoned inner value.
+trait ManagedAuthorityMutex<T> {
+    fn lock_authority(&self) -> std::sync::MutexGuard<'_, T>;
+}
+
+impl<T> ManagedAuthorityMutex<T> for Mutex<T> {
+    #[expect(
+        clippy::expect_used,
+        reason = "poisoned managed authority must never authorize further work"
+    )]
+    fn lock_authority(&self) -> std::sync::MutexGuard<'_, T> {
+        self.lock().expect("managed authority mutex poisoned")
+    }
+}
+
+/// Source-owned accounting for the deliberately broker-only execution profile.
+pub struct AgentWorkflowRuntime {
+    policy: AgentWorkflowPolicy,
+    batch: Mutex<Option<Batch>>,
+    journal: Mutex<Option<(JournalFile, BrokerJournal)>>,
+    intent: Mutex<Option<(IntentFile, ModelRequestIntent)>>,
+    parent_barriers: Mutex<BTreeSet<PathBuf>>,
+    recovery_hold: AtomicBool,
+    invocation: Mutex<Option<(String, String)>>,
+    active_work: AtomicUsize,
+    active_tasks: AtomicUsize,
+    model_tasks: Mutex<BTreeSet<u64>>,
+    next_model_ticket: AtomicU64,
+    generation: AtomicU64,
+    model_generation: AtomicU64,
+    work_finished: tokio::sync::Notify,
+}
+
+pub(crate) struct ManagedWorkGuard {
+    runtime: Arc<AgentWorkflowRuntime>,
+    pub(crate) admitted: bool,
+    model: bool,
+    model_ticket: Option<u64>,
+    generation: u64,
+}
+
+impl ManagedWorkGuard {
+    /// The successor is counted before waiting. Ticket order prevents two
+    /// registered setups from joining each other. The future and its external
+    /// abort owner share this guard until their complete lifecycle has ended.
+    pub(crate) async fn join_predecessors(&self) {
+        let Some(ticket) = self.model_ticket else {
+            return;
+        };
+        loop {
+            let notified = self.runtime.work_finished.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self
+                .runtime
+                .model_tasks
+                .lock_authority()
+                .range(..ticket)
+                .next()
+                .is_none()
+            {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    pub(crate) fn ticket_boundary(&self) -> u64 {
+        self.model_ticket.map_or(0, |ticket| ticket + 1)
+    }
+
+    pub(crate) fn is_admitted(&self) -> bool {
+        self.admitted && self.runtime.generation.load(Ordering::Acquire) == self.generation
+    }
+}
+
+impl Drop for ManagedWorkGuard {
+    fn drop(&mut self) {
+        let counter = if self.model {
+            &self.runtime.active_tasks
+        } else {
+            &self.runtime.active_work
+        };
+        let last = counter.fetch_sub(1, Ordering::AcqRel) == 1;
+        if let Some(ticket) = self.model_ticket {
+            self.runtime.model_tasks.lock_authority().remove(&ticket);
+        }
+        if last || self.model {
+            self.runtime.work_finished.notify_waiters();
+        }
+    }
+}
+
+/// Required for each engine-owned turn; not restored from thread history.
+#[derive(Clone, Debug)]
+pub struct AgentWorkflowInvocation(pub String);
+
+#[derive(Clone, Debug)]
+pub(crate) struct AgentWorkflowCallbackTurn(pub String);
+
+/// Engine-only continuation of the same original turn/invocation and seal.
+/// The exact native journal must validate before this can create callbacks.
+#[derive(Clone, Debug)]
+pub struct AgentWorkflowRecovery(pub AgentWorkflowParkedBatch);
+
+struct Batch {
+    identity: AgentWorkflowParkedBatch,
+    permit_epoch: String,
+    planned: BTreeSet<String>,
+    calls: BTreeMap<String, OriginalCall>,
+    parked: BTreeSet<String>,
+    published: BTreeSet<String>,
+    sealed: bool,
+    attested: bool,
+    delivered: bool,
+    results: BTreeMap<String, DynamicToolResponse>,
+}
+
+pub(crate) struct BatchGuard {
+    runtime: Arc<AgentWorkflowRuntime>,
+    id: String,
+}
+
+impl Drop for BatchGuard {
+    fn drop(&mut self) {
+        let mut state = self.runtime.batch.lock_authority();
+        if let Some(batch) = state
+            .as_ref()
+            .filter(|batch| batch.identity.batch_id == self.id)
+        {
+            let completed =
+                self.runtime
+                    .journal
+                    .lock_authority()
+                    .as_ref()
+                    .is_some_and(|(_, journal)| {
+                        journal.identity.batch_id == self.id
+                            && journal.phase == JournalPhase::Completed
+                    });
+            let unknown_attempt =
+                self.runtime
+                    .intent
+                    .lock_authority()
+                    .as_ref()
+                    .is_some_and(|(_, intent)| {
+                        intent.started.batch_id == self.id && intent.completed.is_none()
+                    });
+            if unknown_attempt || (!batch.planned.is_empty() && !completed) {
+                self.runtime.recovery_hold.store(true, Ordering::Release);
+            }
+            *state = None;
+        }
+    }
+}
+
+impl AgentWorkflowRuntime {
+    /// Synchronously revoke every outstanding permit before joining turn work.
+    pub fn invalidate(&self) {
+        let mut batch = self.batch.lock_authority();
+        self.invalidate_locked(&mut batch);
+    }
+
+    /// Callback failures can only revoke the batch that produced that callback.
+    pub fn invalidate_turn(&self, turn_id: &str) -> bool {
+        let mut batch = self.batch.lock_authority();
+        if batch
+            .as_ref()
+            .is_none_or(|batch| batch.identity.turn_id != turn_id)
+        {
+            return false;
+        }
+        self.invalidate_locked(&mut batch);
+        true
+    }
+
+    fn invalidate_locked(&self, batch: &mut Option<Batch>) {
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        let mut durable = self.journal.lock_authority();
+        let pending_journal = durable
+            .as_ref()
+            .is_some_and(|(_, journal)| journal.phase != JournalPhase::Completed);
+        let incomplete_batch = batch.as_ref().is_some_and(|batch| {
+            !batch.planned.is_empty()
+                && !durable.as_ref().is_some_and(|(_, journal)| {
+                    journal.identity.batch_id == batch.identity.batch_id
+                        && journal.phase == JournalPhase::Completed
+                })
+        });
+        let unknown_attempt = self
+            .intent
+            .lock_authority()
+            .as_ref()
+            .is_some_and(|(_, intent)| intent.completed.is_none());
+        if pending_journal || incomplete_batch || unknown_attempt {
+            self.recovery_hold.store(true, Ordering::Release);
+        }
+        if pending_journal {
+            if let Some((file, journal)) = durable.as_mut() {
+                let mut cancelled = journal.clone();
+                cancelled.phase = JournalPhase::Cancelled;
+                // Failure leaves a hold in memory and the engine's durable
+                // cancelled invocation fence still forbids private recovery.
+                if file.persist(&cancelled, &self.policy).is_ok() {
+                    *journal = cancelled;
+                }
+            }
+        }
+        *batch = None;
+    }
+
+    /// Register before spawning, including a task that will reject invalid work.
+    pub(crate) fn scheduled(self: &Arc<Self>, call: &str) -> ManagedWorkGuard {
+        let batch = self.batch.lock_authority();
+        let admitted = batch
+            .as_ref()
+            .is_some_and(|batch| batch.sealed && batch.planned.contains(call));
+        let generation = self.generation.load(Ordering::Acquire);
+        self.active_work.fetch_add(1, Ordering::AcqRel);
+        ManagedWorkGuard {
+            runtime: Arc::clone(self),
+            admitted,
+            model: false,
+            model_ticket: None,
+            generation,
+        }
+    }
+
+    pub(crate) fn model_scheduled(self: &Arc<Self>) -> ManagedWorkGuard {
+        let _batch = self.batch.lock_authority();
+        let generation = self.generation.load(Ordering::Acquire);
+        let ticket = self.next_model_ticket.fetch_add(1, Ordering::AcqRel);
+        // Exhaustion poisons the authority lock rather than recycling task order.
+        assert_ne!(ticket, u64::MAX, "managed model task ticket exhausted");
+        self.model_tasks.lock_authority().insert(ticket);
+        self.model_generation.store(generation, Ordering::Release);
+        self.active_tasks.fetch_add(1, Ordering::AcqRel);
+        ManagedWorkGuard {
+            runtime: Arc::clone(self),
+            admitted: true,
+            model: true,
+            model_ticket: Some(ticket),
+            generation,
+        }
+    }
+
+    pub(crate) fn model_boundary(&self) -> u64 {
+        let _batch = self.batch.lock_authority();
+        self.next_model_ticket.load(Ordering::Acquire)
+    }
+
+    /// Join only the abort's original predecessors and independent dispatches.
+    /// Its own shared lifecycle guard remains counted through terminal cleanup;
+    /// successors registered after this boundary must never be joined by it.
+    pub(crate) async fn join_abort_work(&self, boundary: u64, owner: Option<&ManagedWorkGuard>) {
+        let excluded = owner.and_then(|guard| guard.model_ticket);
+        loop {
+            let notified = self.work_finished.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            let prior_models = self
+                .model_tasks
+                .lock_authority()
+                .range(..boundary)
+                .any(|ticket| Some(*ticket) != excluded);
+            if !prior_models && self.active_work.load(Ordering::Acquire) == 0 {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    /// The caller first joins the model task so no new deferred dispatch can
+    /// schedule work; then independently spawned dispatch tasks must all exit.
+    pub async fn join_work(&self) {
+        loop {
+            let notified = self.work_finished.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.active_work.load(Ordering::Acquire) == 0
+                && self.active_tasks.load(Ordering::Acquire) == 0
+            {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn new_for_test(policy: AgentWorkflowPolicy) -> Self {
+        Self::new(policy)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn model_tasks_for_test(&self) -> usize {
+        self.active_tasks.load(Ordering::Acquire)
+    }
+
+    fn new(policy: AgentWorkflowPolicy) -> Self {
+        Self {
+            policy,
+            batch: Mutex::new(None),
+            journal: Mutex::new(None),
+            intent: Mutex::new(None),
+            parent_barriers: Mutex::new(BTreeSet::new()),
+            recovery_hold: AtomicBool::new(false),
+            invocation: Mutex::new(None),
+            active_work: AtomicUsize::new(0),
+            active_tasks: AtomicUsize::new(0),
+            model_tasks: Mutex::new(BTreeSet::new()),
+            next_model_ticket: AtomicU64::new(0),
+            generation: AtomicU64::new(0),
+            model_generation: AtomicU64::new(0),
+            work_finished: tokio::sync::Notify::new(),
+        }
+    }
+
+    pub(crate) fn begin(
+        self: &Arc<Self>,
+        thread: String,
+        turn: String,
+        invocation: String,
+    ) -> Result<BatchGuard> {
+        if self.recovery_hold.load(Ordering::Acquire) {
+            return Err(invalid(
+                "an incomplete or cancelled original batch requires recovery hold",
+            ));
+        }
+        if invocation.is_empty()
+            || invocation.len() > 256
+            || !invocation
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))
+        {
+            return Err(invalid("missing or invalid engine invocation identity"));
+        }
+        let mut state = self.batch.lock_authority();
+        if state.is_some()
+            || self.active_work.load(Ordering::Acquire) != 0
+            || self.active_tasks.load(Ordering::Acquire) != 1
+            || self.model_generation.load(Ordering::Acquire)
+                != self.generation.load(Ordering::Acquire)
+        {
+            return Err(invalid("a prior model batch is still live"));
+        }
+        if self
+            .journal
+            .lock_authority()
+            .as_ref()
+            .is_some_and(|(_, journal)| journal.phase != JournalPhase::Completed)
+        {
+            return Err(invalid(
+                "an original broker batch requires explicit receipt recovery or hold",
+            ));
+        }
+        let mut bound = self.invocation.lock_authority();
+        if bound
+            .as_ref()
+            .is_some_and(|(id, previous)| *id == invocation && *previous != turn)
+        {
+            return Err(invalid("a new turn cannot inherit an earlier invocation"));
+        }
+        *bound = Some((invocation.clone(), turn.clone()));
+        let id = uuid::Uuid::new_v4().to_string();
+        *state = Some(Batch {
+            permit_epoch: uuid::Uuid::new_v4().to_string(),
+            identity: AgentWorkflowParkedBatch {
+                thread_id: thread,
+                turn_id: turn,
+                invocation_id: invocation,
+                policy_id: self.policy.policy_id.clone(),
+                build_id: self.policy.build_id.clone(),
+                batch_id: id.clone(),
+                response_id: String::new(),
+                call_ids: Vec::new(),
+            },
+            planned: BTreeSet::new(),
+            calls: BTreeMap::new(),
+            parked: BTreeSet::new(),
+            published: BTreeSet::new(),
+            sealed: false,
+            attested: false,
+            delivered: false,
+            results: BTreeMap::new(),
+        });
+        Ok(BatchGuard {
+            runtime: Arc::clone(self),
+            id,
+        })
+    }
+
+    pub(crate) fn begin_recovery(
+        self: &Arc<Self>,
+        original: &AgentWorkflowParkedBatch,
+        rollout: &Path,
+    ) -> Result<(BatchGuard, Vec<OriginalCall>)> {
+        let mut state = self.batch.lock_authority();
+        if state.is_some()
+            || self.active_work.load(Ordering::Acquire) != 0
+            || self.active_tasks.load(Ordering::Acquire) != 1
+            || self.model_generation.load(Ordering::Acquire)
+                != self.generation.load(Ordering::Acquire)
+        {
+            return Err(invalid(
+                "recovery requires one exclusive counted original task",
+            ));
+        }
+        let raw = read_raw_rollout(rollout)?;
+        let durable = self.journal.lock_authority();
+        let (_, journal) = durable
+            .as_ref()
+            .ok_or_else(|| invalid("original seal absent"))?;
+        if &journal.identity != original
+            || !matches!(
+                journal.phase,
+                JournalPhase::Sealed | JournalPhase::ResultsAccepted
+            )
+        {
+            return Err(invalid(
+                "recovery differs from original pending seal or journal is cancelled/completed",
+            ));
+        }
+        raw.validate_journal(journal, &self.policy)?;
+        let mut intent = self.intent.lock_authority();
+        let (file, value) = intent
+            .as_mut()
+            .ok_or_else(|| invalid("original native request intent absent"))?;
+        let started = &value.started;
+        if started.thread_id != original.thread_id
+            || started.turn_id != original.turn_id
+            || started.invocation_id != original.invocation_id
+            || started.policy_id != original.policy_id
+            || started.build_id != original.build_id
+            || started.batch_id != original.batch_id
+        {
+            return Err(invalid(
+                "a different or unknown native request attempt remains unresolved",
+            ));
+        }
+        let witness =
+            raw.validate_completion(original, &journal.usage, &journal.calls, &self.policy)?;
+        if let Some(completed) = &value.completed {
+            if completed != &witness {
+                return Err(invalid("completed attempt witness differs"));
+            }
+        } else {
+            // Crash after durable seal but before closing its intent. Independent
+            // raw native Completed evidence settles ONLY this exact attempt.
+            let mut completed = value.clone();
+            completed.completed = Some(witness);
+            file.persist(&completed, &self.policy)?;
+            *value = completed;
+        }
+        let calls = journal.calls.clone();
+        let ids = original.call_ids.iter().cloned().collect::<BTreeSet<_>>();
+        *self.invocation.lock_authority() =
+            Some((original.invocation_id.clone(), original.turn_id.clone()));
+        *state = Some(Batch {
+            identity: original.clone(),
+            permit_epoch: uuid::Uuid::new_v4().to_string(),
+            planned: ids,
+            calls: calls
+                .iter()
+                .map(|call| (call.id.clone(), call.clone()))
+                .collect(),
+            parked: BTreeSet::new(),
+            published: BTreeSet::new(),
+            sealed: true,
+            attested: false,
+            delivered: false,
+            results: BTreeMap::new(),
+        });
+        Ok((
+            BatchGuard {
+                runtime: Arc::clone(self),
+                id: original.batch_id.clone(),
+            },
+            calls,
+        ))
+    }
+
+    #[cfg(test)]
+    pub(crate) fn plan(&self, call: &str, tool: &ToolName) -> Result<()> {
+        self.plan_call(call, tool, "{}")
+    }
+
+    pub(crate) fn plan_call(&self, call: &str, tool: &ToolName, arguments: &str) -> Result<()> {
+        if !tool.is_default_namespace() || !self.policy.broker_tools.contains(&tool.name) {
+            return Err(invalid("ungranted tool emitted by model"));
+        }
+        let mut state = self.batch.lock_authority();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if batch.planned.len() >= 128
+            || batch.sealed
+            || call.is_empty()
+            || call.len() > 256
+            || !batch.planned.insert(call.to_owned())
+        {
+            return Err(invalid("late, empty or duplicate planned tool identity"));
+        }
+        if arguments.len() > 1024 * 1024
+            || batch
+                .calls
+                .values()
+                .map(|call| call.arguments.len())
+                .sum::<usize>()
+                + arguments.len()
+                > 8 * 1024 * 1024
+            || serde_json::from_str::<serde_json::Value>(arguments).is_err()
+        {
+            return Err(invalid("invalid or oversized original broker arguments"));
+        }
+        batch.calls.insert(
+            call.to_owned(),
+            OriginalCall {
+                id: call.to_owned(),
+                tool: tool.name.clone(),
+                arguments: arguments.to_owned(),
+            },
+        );
+        Ok(())
+    }
+
+    pub(crate) fn seal(&self, response_id: String) -> Result<()> {
+        let mut state = self.batch.lock_authority();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if batch.sealed || response_id.is_empty() {
+            return Err(invalid("incomplete or duplicate model batch seal"));
+        }
+        batch.identity.response_id = response_id;
+        batch.identity.call_ids = batch.planned.iter().cloned().collect();
+        batch.sealed = true;
+        Ok(())
+    }
+
+    /// Persist before the first transport request. A started intent that has no
+    /// durable actual Completed witness is unknown usage and cannot be retried.
+    pub(crate) fn start_model_intent(&self, rollout: &Path) -> Result<()> {
+        let state = self.batch.lock_authority();
+        let batch = state
+            .as_ref()
+            .ok_or_else(|| invalid("model intent has no admitted batch"))?;
+        sync_raw_rollout(rollout)?;
+        crate::agent_workflow_journal::sync_parent_entries_once(
+            rollout,
+            &mut self.parent_barriers.lock_authority(),
+        )?;
+        let value = ModelRequestIntent::begin(batch.identity.clone(), &self.policy)?;
+        let file = IntentFile::for_rollout(rollout)?;
+        file.persist(&value, &self.policy)?;
+        *self.intent.lock_authority() = Some((file, value));
+        Ok(())
+    }
+
+    pub(crate) fn model_witness(
+        &self,
+        turn_id: &str,
+        response_id: &str,
+        usage: &codex_protocol::protocol::TokenUsage,
+    ) -> Result<codex_protocol::protocol::AgentWorkflowModelWitness> {
+        let state = self.batch.lock_authority();
+        let batch = state
+            .as_ref()
+            .ok_or_else(|| invalid("native response usage witness has no live model batch"))?;
+        if batch.identity.turn_id != turn_id || batch.sealed || response_id.is_empty() {
+            return Err(invalid("late or foreign native response usage witness"));
+        }
+        let mut identity = batch.identity.clone();
+        identity.response_id = response_id.to_owned();
+        identity.call_ids = batch.planned.iter().cloned().collect();
+        let mut value = serde_json::to_value(usage).map_err(|error| invalid(&error.to_string()))?;
+        if let Some(units) = &usage.codex_rollout_budget_units {
+            value
+                .as_object_mut()
+                .ok_or_else(|| invalid("invalid native usage"))?
+                .insert(
+                    "codex_rollout_budget_units".into(),
+                    serde_json::Value::Number(units.clone()),
+                );
+        }
+        Ok(codex_protocol::protocol::AgentWorkflowModelWitness {
+            batch: identity,
+            usage: value,
+        })
+    }
+
+    /// The model task has already materialized and flushed the native writer.
+    /// Establish explicit raw-history and journal durability BEFORE polling tools.
+    pub(crate) fn seal_durable(
+        &self,
+        response_id: String,
+        rollout: &Path,
+        usage: serde_json::Value,
+    ) -> Result<()> {
+        self.seal(response_id)?;
+        let state = self.batch.lock_authority();
+        let batch = state
+            .as_ref()
+            .ok_or_else(|| invalid("batch disappeared before durable seal"))?;
+        sync_raw_rollout(rollout)?;
+        crate::agent_workflow_journal::sync_parent_entries_once(
+            rollout,
+            &mut self.parent_barriers.lock_authority(),
+        )?;
+        let raw = read_raw_rollout(rollout)?;
+        let calls = batch.calls.values().cloned().collect::<Vec<_>>();
+        let witness = raw.validate_completion(&batch.identity, &usage, &calls, &self.policy)?;
+        if !batch.planned.is_empty() {
+            let journal =
+                BrokerJournal::sealed(batch.identity.clone(), calls, usage, &self.policy)?;
+            raw.validate_journal(&journal, &self.policy)?;
+            let file = JournalFile::for_rollout(rollout)?;
+            file.persist(&journal, &self.policy)?;
+            *self.journal.lock_authority() = Some((file, journal));
+        }
+        let mut intent = self.intent.lock_authority();
+        let (file, original) = intent
+            .as_mut()
+            .ok_or_else(|| invalid("native completion lacks original model intent"))?;
+        let mut completed = original.clone();
+        completed.completed = Some(witness);
+        file.persist(&completed, &self.policy)?;
+        *original = completed;
+        Ok(())
+    }
+
+    /// Caller first flushes and syncs every native real output. The completion
+    /// marker is a second ordered durable barrier before another model request.
+    pub(crate) fn complete_durable(&self, rollout: &Path) -> Result<()> {
+        let state = self.batch.lock_authority();
+        let batch = state
+            .as_ref()
+            .ok_or_else(|| invalid("batch disappeared before durable completion"))?;
+        if batch.planned.is_empty() {
+            return Ok(());
+        }
+        sync_raw_rollout(rollout)?;
+        let mut journal = self.journal.lock_authority();
+        let (file, value) = journal
+            .as_mut()
+            .ok_or_else(|| invalid("durable result journal absent"))?;
+        let raw = read_raw_rollout(rollout)?;
+        raw.validate_journal(value, &self.policy)?;
+        let mut completed = value.clone();
+        completed.complete(&raw.responses)?;
+        file.persist(&completed, &self.policy)?;
+        *value = completed;
+        self.recovery_hold.store(false, Ordering::Release);
+        Ok(())
+    }
+
+    pub(crate) fn recovered_outputs(
+        &self,
+        rollout: &Path,
+    ) -> Result<Vec<codex_protocol::models::ResponseItem>> {
+        let state = self.batch.lock_authority();
+        let batch = state
+            .as_ref()
+            .ok_or_else(|| invalid("recovery batch absent"))?;
+        if !batch.delivered {
+            return Err(invalid(
+                "recovery results have not all received the fresh permit",
+            ));
+        }
+        let durable = self.journal.lock_authority();
+        let (_, journal) = durable
+            .as_ref()
+            .ok_or_else(|| invalid("recovery journal absent"))?;
+        if journal.identity != batch.identity {
+            return Err(invalid("recovery journal identity changed"));
+        }
+        let raw = read_raw_rollout(rollout)?;
+        raw.validate_journal(journal, &self.policy)?;
+        Ok(journal.missing_real_outputs(&raw.responses)?)
+    }
+
+    fn load_journal(&self, rollout: &Path, thread: &str) -> Result<()> {
+        let raw = read_raw_rollout(rollout)?;
+        raw.validate_header(thread, &self.policy)?;
+        let intent_file = IntentFile::for_rollout(rollout)?;
+        match intent_file.load(&self.policy) {
+            Ok(intent) => {
+                if intent.started.thread_id != thread {
+                    return Err(invalid("foreign model intent thread"));
+                }
+                if let Some(witness) = &intent.completed {
+                    raw.validate_intent_witness(witness, &self.policy)?;
+                } else {
+                    self.recovery_hold.store(true, Ordering::Release);
+                }
+                *self.intent.lock_authority() = Some((intent_file, intent));
+            }
+            Err(error)
+                if error.kind() == std::io::ErrorKind::NotFound
+                    && !raw.items.iter().any(|item| {
+                        matches!(
+                            item,
+                            RolloutItem::TokenUsageRecord(_)
+                                | RolloutItem::ResponseItem(codex_history::ResponseItemEnvelope {
+                                    item: codex_protocol::models::ResponseItem::FunctionCall { .. },
+                                    ..
+                                })
+                        )
+                    }) => {}
+            Err(error) => return Err(error.into()),
+        }
+        let file = JournalFile::for_rollout(rollout)?;
+        match file.load(&self.policy) {
+            Ok(journal) => {
+                raw.validate_journal(&journal, &self.policy)?;
+                if journal.phase == JournalPhase::Completed
+                    && !journal.missing_real_outputs(&raw.responses)?.is_empty()
+                {
+                    return Err(invalid("completed marker has missing real outputs"));
+                }
+                *self.journal.lock_authority() = Some((file, journal));
+            }
+            Err(error)
+                if error.kind() == std::io::ErrorKind::NotFound
+                    && !raw.responses.iter().any(|item| {
+                        matches!(
+                            item,
+                            codex_protocol::models::ResponseItem::FunctionCall { .. }
+                        )
+                    }) => {}
+            Err(error) => return Err(error.into()),
+        }
+        Ok(())
+    }
+
+    pub(crate) fn park(&self, call: &str) -> Result<()> {
+        let mut state = self.batch.lock_authority();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if !batch.sealed || !batch.planned.contains(call) || !batch.parked.insert(call.to_owned()) {
+            return Err(invalid("unsealed, unknown or duplicate parked callback"));
+        }
+        Ok(())
+    }
+
+    fn batch_permit(&self, batch: &Batch) -> Result<AgentWorkflowBatchPermit> {
+        let durable = self.journal.lock_authority();
+        let usage = match durable.as_ref() {
+            Some((_, journal))
+                if journal.identity == batch.identity
+                    && matches!(
+                        journal.phase,
+                        JournalPhase::Sealed | JournalPhase::ResultsAccepted
+                    ) =>
+            {
+                journal.usage.clone()
+            }
+            None if cfg!(test) => {
+                serde_json::json!({"input_tokens":0,"output_tokens":0,"total_tokens":0})
+            }
+            _ => {
+                return Err(invalid(
+                    "attestation lacks its exact durable native usage witness",
+                ));
+            }
+        };
+        Ok(AgentWorkflowBatchPermit {
+            batch: batch.identity.clone(),
+            permit_epoch: batch.permit_epoch.clone(),
+            usage,
+        })
+    }
+
+    /// Called after the app-server has queued this call's public RPC request.
+    /// No attestation exists until every deferred future is both parked and published.
+    pub fn published(&self, call: &str) -> Result<Option<AgentWorkflowBatchPermit>> {
+        let mut state = self.batch.lock_authority();
+        let batch = state.as_mut().ok_or_else(|| invalid("no model batch"))?;
+        if !batch.parked.contains(call) || !batch.published.insert(call.to_owned()) {
+            return Err(invalid("unknown or duplicate published callback"));
+        }
+        if batch.sealed
+            && !batch.attested
+            && !batch.planned.is_empty()
+            && batch.planned == batch.parked
+            && batch.planned == batch.published
+            && self.active_work.load(Ordering::Acquire) == batch.planned.len()
+            && self.active_tasks.load(Ordering::Acquire) == 1
+            && self.model_generation.load(Ordering::Acquire)
+                == self.generation.load(Ordering::Acquire)
+        {
+            batch.attested = true;
+            return Ok(Some(self.batch_permit(batch)?));
+        }
+        Ok(None)
+    }
+
+    #[cfg(test)]
+    fn accept_result(
+        &self,
+        call: &str,
+        response: DynamicToolResponse,
+    ) -> Result<Vec<(String, DynamicToolResponse)>> {
+        self.accept_result_bound(None, call, response)
+    }
+
+    pub(crate) fn accept_result_for_turn(
+        &self,
+        turn_id: &str,
+        call: &str,
+        response: DynamicToolResponse,
+    ) -> Result<Vec<(String, DynamicToolResponse)>> {
+        self.accept_result_bound(Some(turn_id), call, response)
+    }
+
+    fn accept_result_bound(
+        &self,
+        turn_id: Option<&str>,
+        call: &str,
+        mut response: DynamicToolResponse,
+    ) -> Result<Vec<(String, DynamicToolResponse)>> {
+        let mut state = self.batch.lock_authority();
+        // Check ownership under the same lock as receipt mutation. A delayed
+        // response must never erase or revoke another turn's batch.
+        if turn_id.is_some_and(|id| {
+            state
+                .as_ref()
+                .is_none_or(|batch| batch.identity.turn_id != id)
+        }) {
+            return Err(invalid("dynamic response belongs to another turn"));
+        }
+        let batch = state
+            .as_mut()
+            .ok_or_else(|| invalid("no live parked batch"))?;
+        let permit = response.agent_workflow_permit.take();
+        if !batch.attested
+            || batch.delivered
+            || permit.as_ref() != Some(&self.batch_permit(batch)?)
+            || !batch.planned.contains(call)
+            || batch.results.contains_key(call)
+        {
+            *state = None;
+            return Err(invalid(
+                "early, changed, duplicate or stale batch permit/result",
+            ));
+        }
+        batch.results.insert(call.to_owned(), response);
+        if batch.results.len() != batch.planned.len() {
+            return Ok(Vec::new());
+        }
+        // Persist the entire semantic batch before delivering even one oneshot.
+        // Test-only memory runtimes have no local journal and never admit a real
+        // managed app-server callback without seal_durable's barrier.
+        if let Some((file, journal)) = self.journal.lock_authority().as_mut() {
+            if journal.phase == JournalPhase::ResultsAccepted {
+                // Replay must return the exact already durable semantic set;
+                // the fresh control epoch never changes original result bytes.
+                if journal.results != batch.results {
+                    *state = None;
+                    return Err(invalid(
+                        "replayed results differ from original accepted semantic receipts",
+                    ));
+                }
+            } else {
+                let mut accepted = journal.clone();
+                accepted.accept_results(batch.results.clone(), &self.policy)?;
+                file.persist(&accepted, &self.policy)?;
+                *journal = accepted;
+            }
+        } else if !cfg!(test) {
+            return Err(invalid("result delivery requires a durable original seal"));
+        }
+        batch.delivered = true;
+        Ok(std::mem::take(&mut batch.results).into_iter().collect())
+    }
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!("agent-workflow managed policy: {message}"))
+}
+
+fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn validate_catalog(policy: &AgentWorkflowPolicy, tools: &[DynamicToolSpec]) -> Result<()> {
+    if policy.broker_tools.len() > 128 || tools.len() > 128 {
+        return Err(invalid("managed catalog exceeds 128 tools"));
+    }
+    let mut names = BTreeSet::new();
+    for name in &policy.broker_tools {
+        let Some(suffix) = name.strip_prefix("broker_") else {
+            return Err(invalid("only engine broker wire names are permitted"));
+        };
+        if !hex(suffix, 24) || !names.insert(name.as_str()) {
+            return Err(invalid("invalid or duplicate broker tool name"));
+        }
+    }
+    if !policy.broker_tools.windows(2).all(|pair| pair[0] < pair[1]) {
+        return Err(invalid("broker tool ceiling must use canonical ordering"));
+    }
+    let mut actual = BTreeSet::new();
+    for tool in tools {
+        let DynamicToolSpec::Function(tool) = tool else {
+            return Err(invalid("broker namespace containers are unsupported"));
+        };
+        if tool.defer_loading || !actual.insert(tool.name.as_str()) {
+            return Err(invalid("duplicate or deferred broker definition"));
+        }
+    }
+    if actual != names {
+        return Err(invalid(
+            "dynamic tool catalog differs from the exact ceiling",
+        ));
+    }
+    Ok(())
+}
