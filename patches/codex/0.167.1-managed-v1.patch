+#[derive(Clone)]
+struct ManagedSourceTask {
+    polled: Arc<std::sync::atomic::AtomicBool>,
+    started: Arc<Notify>,
+    release: Arc<Notify>,
+}
+
+impl SessionTask for ManagedSourceTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+
+    fn span_name(&self) -> &'static str {
+        "session_task.managed_source_fixture"
+    }
+
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        self.polled
+            .store(true, std::sync::atomic::Ordering::Release);
+        self.started.notify_one();
+        tokio::select! {
+            _ = self.release.notified() => Ok(None),
+            _ = cancellation_token.cancelled() => Err(CodexErr::TurnAborted),
+            _ = tokio::time::sleep(StdDuration::from_secs(5)) => {
+                Err(CodexErr::InvalidRequest("managed fixture release deadline".into()))
+            }
+        }
+    }
+}
