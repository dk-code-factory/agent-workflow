+        input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        self.inner
+            .polled
+            .store(true, std::sync::atomic::Ordering::Release);
+        let (items, _, errors) = RolloutRecorder::load_rollout_items(&self.rollout)
+            .await
+            .expect("read original terminal durability at successor entry");
+        assert_eq!(errors, 0);
+        assert!(
+            items.iter().any(|item| matches!(
+                item,
+                RolloutItem::EventMsg(EventMsg::TurnAborted(event))
+                    if event.turn_id.as_deref() == Some(self.original_turn.as_str())
+            )),
+            "original terminal event must be durable before successor execution"
+        );
+        // Use the same real event producer as RegularTask rather than waiting
+        // for an event that the generic task runner never produces.
+        session.emit_turn_started(&ctx, TaskKind::Regular).await;
+        Arc::new(self.inner.clone())
+            .run(session, ctx, input, cancellation)
+            .await
+    }
+}
