+#[tokio::test]
+async fn managed_submission_ceiling_rejects_manual_and_unbound_work_before_queueing() {
+    let (tx_sub, rx_sub) = async_channel::bounded(1);
+    let (_tx_event, rx_event) = async_channel::unbounded();
+    let io = SessionIo {
+        agent_workflow_managed: true,
+        tx_sub,
+        rx_event,
+        agent_status: watch::channel(AgentStatus::PendingInit).1,
+        session_loop_termination: completed_session_loop_termination(),
+    };
+    for operation in [
+        Op::Compact,
+        Op::Review {
+            review_request: codex_protocol::protocol::ReviewRequest {
+                target: codex_protocol::protocol::ReviewTarget::UncommittedChanges,
+                user_facing_hint: None,
+            },
+        },
+        Op::ReloadUserConfig,
+        Op::RunUserShellCommand {
+            command: "touch forbidden-managed-effect".into(),
+            timeout_ms: Some(1),
+        },
+    ] {
+        assert!(io.submit(operation).await.is_err());
+        assert!(rx_sub.is_empty());
+    }
+    let (reply, _result) = tokio::sync::oneshot::channel();
+    let unbound_start = Op::TurnInput {
+        request: Box::new(TurnInputRequest::new(SubmittedTurnInput::UserInput {
+            content: Vec::new(),
+            client_id: None,
+        })),
+        mode: TurnInputMode::StartIfIdle,
+        reply,
+    };
+    assert!(io.submit(unbound_start).await.is_err());
+    assert!(rx_sub.is_empty());
+    let (reply, _result) = tokio::sync::oneshot::channel();
+    let unbound_recovery = Op::RecoverTurn {
+        thread_settings: Default::default(),
+        start_options: Default::default(),
+        reply,
+    };
+    assert!(io.submit(unbound_recovery).await.is_err());
+    assert!(rx_sub.is_empty());
+    assert!(io.submit(Op::Shutdown).await.is_ok());
+    assert!(matches!(rx_sub.recv().await.unwrap().op, Op::Shutdown));
+}
