{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dk-code-factory/dk-workflows/main/codex/skills/dk-pr-feedback-reply/config.schema.json",
  "title": "dk-workflows:dk-pr-feedback-reply options",
  "type": "object",
  "properties": {
    "resolve_answered_threads": {
      "type": "boolean",
      "default": true,
      "description": "Resolve fully answered inline threads only when authorized; false leaves them unresolved after replying."
    },
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*\\u0000)[\\s\\S]*$"
    }
  },
  "additionalProperties": false
}
