{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dk-code-factory/dk-workflows/main/codex/skills/dk-pr-fix/config.schema.json",
  "title": "dk-workflows:dk-pr-fix options",
  "type": "object",
  "properties": {
    "tasks": {
      "$ref": "../../../schemas/invocation.schema.json#/$defs/plan",
      "default": [
        {
          "skill": "dk-workflows:dk-pr-feedback-read",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-decisions",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-feedback-address",
          "options": {},
          "required": true,
          "instructions": "Verify and address actionable discussion feedback within the agreed scope."
        },
        {
          "skill": "dk-workflows:dk-pr-publish",
          "options": {},
          "required": true,
          "instructions": "Publish concrete prepared feedback-fix actions when authorized; otherwise return a no-op assessment."
        },
        {
          "skill": "dk-workflows:dk-pr-split",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-description",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-reviewers-run",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-feedback-address",
          "options": {},
          "required": true,
          "instructions": "Assess the current original reviewer outputs and address actionable findings within the agreed scope."
        },
        {
          "skill": "dk-workflows:dk-pr-publish",
          "options": {},
          "required": true,
          "instructions": "Publish concrete prepared reviewer-fix actions when authorized; otherwise return a no-op assessment."
        }
      ],
      "description": "Ordered invocations for the owning skill; explicit parallel groups join before continuing. The skill controls iteration and applicability."
    },
    "finalizers": {
      "$ref": "../../../schemas/invocation.schema.json#/$defs/plan",
      "default": [
        {
          "skill": "dk-workflows:dk-commit-split",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-decisions",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-description",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-feedback-reply",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-ci",
          "options": {},
          "required": true
        },
        {
          "skill": "dk-workflows:dk-pr-publish",
          "options": {},
          "required": true
        }
      ],
      "description": "Ordered completion invocations. An explicit empty list disables inherited finalizers without claiming omitted checks passed."
    },
    "limits": {
      "type": "object",
      "properties": {
        "review_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 5
        },
        "retries_per_task": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Zero disables these attempts; retained counters and tighter limits survive resume."
        },
        "ci_repairs_per_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 5,
          "description": "Zero disables these attempts; retained counters and tighter limits survive resume."
        },
        "ci_reruns_per_head": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 3,
          "description": "Zero disables these attempts; retained counters and tighter limits survive resume."
        }
      },
      "additionalProperties": false,
      "default": {
        "review_cycles": 5,
        "retries_per_task": 1,
        "ci_repairs_per_cycle": 5,
        "ci_reruns_per_head": 3
      },
      "description": "Retained execution ceilings. Lower settings never reset consumed counters or grant a fresh run."
    },
    "permissions": {
      "type": "object",
      "properties": {
        "push_commits": {
          "type": "boolean",
          "default": true
        },
        "rewrite_commits": {
          "type": "boolean",
          "default": true
        },
        "edit_pr": {
          "type": "boolean",
          "default": true
        },
        "reply_to_feedback": {
          "type": "boolean",
          "default": true
        },
        "resolve_threads": {
          "type": "boolean",
          "default": true
        },
        "create_draft_prs": {
          "type": "boolean",
          "default": true
        },
        "request_review": {
          "type": "boolean",
          "default": true
        },
        "post_review": {
          "type": "boolean",
          "default": false
        },
        "approve_fork_ci": {
          "type": "boolean",
          "default": false
        },
        "approve_pr": {
          "type": "boolean",
          "default": false
        },
        "merge_pr": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "default": "squash",
              "enum": [
                "squash",
                "merge"
              ],
              "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*\\u0000)[\\s\\S]*$"
            }
          },
          "additionalProperties": false,
          "default": {
            "enabled": false,
            "method": "squash"
          }
        }
      },
      "additionalProperties": false,
      "default": {
        "push_commits": true,
        "rewrite_commits": true,
        "edit_pr": true,
        "reply_to_feedback": true,
        "resolve_threads": true,
        "create_draft_prs": true,
        "request_review": true,
        "post_review": false,
        "approve_fork_ci": false,
        "approve_pr": false,
        "merge_pr": {
          "enabled": false,
          "method": "squash"
        }
      },
      "description": "Actions permitted by saved policy, subject to the actual assignment and narrower current user instructions."
    },
    "completion_instructions": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "default": null,
      "description": "Additional completion instructions; null uses the existing completion contract. Cannot expand permission or restore omitted finalizers.",
      "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*\\u0000)[\\s\\S]*$"
    },
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*\\u0000)[\\s\\S]*$"
    }
  },
  "additionalProperties": false
}
